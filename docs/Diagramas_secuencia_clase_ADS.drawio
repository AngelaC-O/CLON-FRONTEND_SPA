as="sourcePoint" /><mxPoint x="2780" y="1622" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p02-96" value="false" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2770" y="1652" as="sourcePoint" /><mxPoint x="935" y="1652" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p02-97" value="oCliente = new Cliente(idPersona, fechaCumpleanos, observaciones) [RF03]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1682" as="sourcePoint" /><mxPoint x="2565" y="1682" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p02-98" value="registrarConsentimiento(aceptaComunicaciones, fechaConsentimiento) [RF04, RN27]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1712" as="sourcePoint" /><mxPoint x="2565" y="1712" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p02-99" value="save(oCliente)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1742" as="sourcePoint" /><mxPoint x="2770" y="1742" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p02-100" value="INSERT INTO CLIENTE" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2780" y="1772" as="sourcePoint" /><mxPoint x="2975" y="1772" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p02-101" value="idCliente" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2975" y="1802" as="sourcePoint" /><mxPoint x="2780" y="1802" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p02-102" value="oCliente" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2770" y="1832" as="sourcePoint" /><mxPoint x="935" y="1832" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p02-103" value="oClienteDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1862" as="sourcePoint" /><mxPoint x="730" y="1862" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p02-104" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1892" as="sourcePoint" /><mxPoint x="525" y="1892" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p02-105" value="mostrarFicha(oClienteDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1922" as="sourcePoint" /><mxPoint x="320" y="1922" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p02-106" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1982" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p02-107" value="La IGU carga los tipos de documento activos con GET /api/v1/tipos-documento (CUS65). Solo DNI y RUC tienen consulta_api = 'S' y se consultan en APISPERU; con carnet, pasaporte o cédula, o si la consulta falla o tarda más de 3 s, los datos se ingresan a mano y PERSONA queda MANUAL (RF99, RN45, CK_PERSONA_VERIFICADO). El documento de la clienta es opcional." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p02-108" value="Herencia del v5: primero PERSONA (supertipo, módulo seguridad, por ServicioPersona = PersonaApi) y luego CLIENTE con el mismo id (PK compartida, FK_CLIENTE_PERSONA). Si la persona ya existe (por ejemplo, es del personal), registrarPersona devuelve su id y solo se agrega CLIENTE: la jerarquía es solapada." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p02-109" value="Si esa persona ya es CLIENTE (existsById = true), el sistema avisa que el teléfono o el documento ya pertenecen a otra ficha y no guarda (RF05, UQ_PERSONA_TELEFONO, UQ_PERSONA_DOCUMENTO). Nombre y teléfono son obligatorios (RF03, TRG_CLIENTE_HERENCIA). El token de APISPERU no se guarda en la BD (RNF32)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p02-110" value="Diagrama de clases del análisis — Registrar Clienta" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="2052" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p02-111" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="2112" width="30" height="60" as="geometry" /></mxCell><mxCell id="p02-112" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2112" width="110" height="80" as="geometry" /></mxCell><mxCell id="p02-113" value="IGU_Clientas" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2262" width="110" height="80" as="geometry" /></mxCell><mxCell id="p02-114" value="ControladorCliente" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="677.0" y="2112" width="80" height="80" as="geometry" /></mxCell><mxCell id="p02-115" value="ServicioCliente" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="971.0" y="2112" width="80" height="80" as="geometry" /></mxCell><mxCell id="p02-116" value="ServicioPersona" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strok