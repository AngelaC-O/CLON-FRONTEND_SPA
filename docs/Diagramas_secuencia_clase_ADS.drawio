x="40" y="1486" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p32-76" value="tipo_uso clasifica el producto como VENTA o INSUMO de uso interno (RF44, RN13)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p32-77" value="precio_venta = costo × (1 + margen); el margen vive en PARAMETRO (seguridad), no en el código, y la encargada puede ajustarlo antes de guardar (RF87)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p32-78" value="El stock mínimo se configura por producto y por sede en INVENTARIO_SEDE (RF86, RN16)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p32-79" value="[It. 2] listarProductos lista productos e insumos con su stock de la sede; lo usan CUS33 a CUS35 y el registro de insumos de CUS57 (diferencia 34 del front-end). El producto nace con stock 0 en la sede: el stock solo cambia por kardex (TRG_KARDEX_APLICAR)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="600" width="330" height="90" as="geometry" /></mxCell><mxCell id="p32-80" value="Diagrama de clases del análisis — Registrar Producto" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1556" width="1400" height="30" as="geometry" /></mxCell><mxCell 