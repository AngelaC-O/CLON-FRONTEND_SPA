esizable=0;html=1;align=left;verticalAlign=bottom;fontSize=11;fontStyle=1;" vertex="1" connectable="0" parent="p66-145"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="p66-147" value="0..*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=11;fontStyle=1;" vertex="1" connectable="0" parent="p66-145"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="CUS67 Publicar Canal en Línea" id="p67"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p67-1" value="CUS67 · Publicar Canal en Línea" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry" /></mxCell><mxCell id="p67-2" value="&lt;b&gt;Módulo:&lt;/b&gt; sedes &amp;nbsp;·&amp;nbsp; &lt;b&gt;Actor:&lt;/b&gt; Administradora &amp;nbsp;·&amp;nbsp; &lt;b&gt;Requerimientos:&lt;/b&gt; RF94, RF95 &amp;nbsp;·&amp;nbsp; &lt;b&gt;Reglas:&lt;/b&gt; — &amp;nbsp;·&amp;nbsp; &lt;b&gt;Diccionario v5.2 — escribe:&lt;/b&gt; ninguna &amp;nbsp;·&amp;nbsp; &lt;b&gt;consulta:&lt;/b&gt; —" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="2000" height="24" as="geometry" /></mxCell><mxCell id="p67-3" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="30" height="60" as="geometry" /></mxCell><mxCell id="p67-4" value="Publicar Canal en Línea" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="95" width="300" height="60" as="geometry" /></mxCell><mxCell id="p67-5" value="" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;" edge="1" parent="1" source="p67-3" target="p67-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p67-6" value="Realización&lt;br&gt;Publicar Canal en Línea" style="ellipse;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="95" width="300" height="60" as="geometry" /></mxCell><mxCell id="p67-7" value="&amp;laquo;trace&amp;raquo;" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="p67-6" target="p67-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p67-8" value="Modelo de requerimientos → Modelo de análisis" style="text;html=1;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="360" height="20" as="geometry" /></mxCell><mxCell id="p67-9" value="Won't Have en la versión 1 (RF94 y RF95, priorización). El diccionario v5 (27/10/2026) retiró SEDE_CANAL, así que este CUS no tiene tablas ni realización en la versión 1." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="900" height="70" as="geometry" /></mxCell><mxCell id="p67-10" value="Si la dueña sube RF94 o RF95 al alcance, primero se agrega la tabla del canal al diccionario y luego se diseña aquí la realización, junto con CUS17 y CUS27." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="900" height="70" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="General · Clases del análisis" id="pga"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="pga-1" value="Diagrama general de clases del análisis — Sistema BackOffice Cautiva Spa (64 realizaciones de 67 CUS)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="40" as="geometry" /></mxCell><mxCell id="pga-2" value="Unión de las clases de análisis de las 64 realizaciones (CUS17, CUS27 y CUS67 no tienen realización en v5), agrupadas por módulo (Unidad 1). Actor → Frontera (IGU_) → Control → Entidad; las entidades de tabla son las del diccionario v5.2." style="text;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1600" height="24" as="geometry" /></mxCell><mxCell id="pga-3" value="Módulo agenda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="4440" height="1090" as="geometry" /></mxCell><mxCell id="pga-4" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2025.0" y="150" width="30" height="60" as="geometry" /></mxCell><mxCell id="pga-5" value="Especialista Técnica" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2225.0" y="150" width="30" height="60" as="geometry" /></mxCell><mxCell id="pga-6" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=b