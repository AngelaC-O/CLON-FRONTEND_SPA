mxGeometry></mxCell><mxCell id="p08-44" value="lista&amp;lt;BloqueAgenda&amp;gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="690" as="sourcePoint" /><mxPoint x="1140" y="690" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-45" value="lista&amp;lt;FranjaAgendaDTO&amp;gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="720" as="sourcePoint" /><mxPoint x="935" y="720" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-46" value="lista&amp;lt;FranjaAgendaDTO&amp;gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="750" as="sourcePoint" /><mxPoint x="730" y="750" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-47" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="780" as="sourcePoint" /><mxPoint x="525" y="780" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-48" value="mostrarAgenda(lista) [RF11]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="810" as="sourcePoint" /><mxPoint x="320" y="810" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-49" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p08-50" value="Vista por día, por especialista y por recurso con franjas libres y ocupadas (RF11). idPersonal e idRecurso son filtros opcionales." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p08-51" value="Cada bloque ocupado incluye el tiempo de limpieza del recurso (RN03) y las atenciones sin cita en curso (ATENCION)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p08-52" value="Diagrama de clases del análisis — Consultar Agenda" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p08-53" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1000" width="30" height="60" as="geometry" /></mxCell><mxCell id="p08-54" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="3