" /><mxPoint x="2770" y="1352" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p19-87" value="oRespuestaCpe" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2770" y="1382" as="sourcePoint" /><mxPoint x="2575" y="1382" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p19-88" value="oRespuestaCpe" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2565" y="1412" as="sourcePoint" /><mxPoint x="1755" y="1412" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p19-89" value="guardar(rutaArchivo, contenido) [RF100]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1755" y="1442" as="sourcePoint" /><mxPoint x="2360" y="1442" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p19-90" value="ruta" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2360" y="1472" as="sourcePoint" /><mxPoint x="1755" y="1472" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p19-91" value="registrarRespuestaSunat(estadoSunat, codigoRespuesta, descripcionRespuesta, hashCpe, rutaXml, rutaCdr) [RF100]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1755" y="1502" as="sourcePoint" /><mxPoint x="1950" y="1502" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p19-92" value="save(oComprobante)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1755" y="1532" as="sourcePoint" /><mxPoint x="2155" y="1532" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p19-93" value="UPDATE COMPROBANTE" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2165" y="1562" as="sourcePoint" /><mxPoint x="2975" y="1562" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p19-94" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2975" y="1592" as="sourcePoint" /><mxPoint x="2165" y="1592" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p19-95" value="oComprobante" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="1622" as="sourcePoint" /><mxPoint x="935" y="1622" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p19-96" value="oVentaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1652" as="sourcePoint" /><mxPoint x="730" y="1652" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p19-97" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1682" as="sourcePoint" /><mxPoint x="525" y="1682" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p19-98" value="mostrarEstadoSunat(oVentaDTO) [RF100, RF101]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1712" as="sourcePoint" /><mxPoint x="320" y="1712" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p19-99" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1772" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p19-100" value="«include» de CUS18 Cobrar Venta, CUS26 Vender Producto y CUS13 Registrar Atención sin Cita: es la misma operación POST /cierre. Aquí se ve la parte del comprobante; el cambio de la venta a CERRADA está en CUS18 (Venta.cerrar() rechaza la venta sin comprobante: RF28, RN10)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p19-101" value="v5: COMPROBANTE es el supertipo (aquí tipo BOLETA o FACTURA). El comprador se identifica con id_tipo_doc_comprador → TIPO_DOCUMENTO y una copia fija del número y del nombre; la factura exige RUC (TRG_COMPROBANTE_COMPRADOR) y la boleta de más de S/700, nombre y documento (RF29, RN08). Serie y número los asigna la BD desde SERIE_COMPROBANTE sin saltos (RN47); UQ_COMPROBANTE_VENTA_CLASE deja un solo comprobante por venta." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p19-102" value="Si APISPERU o SUNAT no responden, el comprobante queda PENDIENTE y la venta se cierra igual; ReenvioCpeJob lo reenvía y alerta los que se acercan al plazo de 3 días (RF101, RN46, CPE_PLAZO_ENVIO_DIAS)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p19-103" value="[It. 2.1 · nombres] La respuesta trae también los nombres que la pantalla muestra (nunca solo el id): ver la página «Nombres en las respuestas · It. 2.1» (la línea de producto del comprobante lleva el nombre del producto (InventarioApi.obtenerProductos), no «PRODUCTO»; cierra D-33)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="600" width="330" height="90" as="geometry" /></mxCell><mxCell id="p19-104" value="Diagrama de clases del análisis — Emitir Comprobante Electrónico" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1842" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p19-105" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1902" width="30" height="60" as="geometry" /></mxCell><mxCell id="p19-106" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y=