lative="1" as="geometry"><mxPoint x="935" y="1128" as="sourcePoint" /><mxPoint x="1130" y="1128" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-70" value="true" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="1158" as="sourcePoint" /><mxPoint x="935" y="1158" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-71" value="oCita = new Cita(idCliente, idSede, idPersonal, idRecurso, idVariante, fechaHoraInicio, duracionMin, idUsuario) [RF07, RN03]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1188" as="sourcePoint" /><mxPoint x="1335" y="1188" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-72" value="save(oCita)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1218" as="sourcePoint" /><mxPoint x="1540" y="1218" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-73" value="INSERT INTO CITA" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="1248" as="sourcePoint" /><mxPoint x="2360" y="1248" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-74" value="idCita" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2360" y="1278" as="sourcePoint" /><mxPoint x="1550" y="1278" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-75" value="oCita" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="1308" as="sourcePoint" /><mxPoint x="935" y="1308" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-76" value="findById(idEspera) [RF09]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1338" as="sourcePoint" /><mxPoint x="1950" y="1338" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-77" value="SELECT * FROM LISTA_ESPERA" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1960" y="1368" as="sourcePoint" /><mxPoint x="2360" y="1368" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-78" value="fila" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2360" y="1398" as="sourcePoint" /><mxPoint x="1960" y="1398" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-79" value="oListaEspera" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="1428" as="sourcePoint" /><mxPoint x="935" y="1428" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-80" value="asignarCita(idCita) [RF09]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1458" as="sourcePoint" /><mxPoint x="2155" y="1458" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-81" value="save(oListaEspera)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1488" as="sourcePoint" /><mxPoint x="1950" y="1488" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-82" value="UPDATE LISTA_ESPERA" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1960" y="1518" as="sourcePoint" /><mxPoint x="2360" y="1518" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-83" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2360" y="1548" as="sourcePoint" /><mxPoint x="1960" y="1548" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-84" value="oCitaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1578" as="sourcePoint" /><mxPoint x="730" y="1578" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-85" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1608" as="sourcePoint" /><mxPoint x="525" y="1608" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-86" value="mostrarCita(oCitaDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1638" as="sourcePoint" /><mxPoint x="320" y="1638" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-87" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1698" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p05-88" value="La clienta se elige con «include» CUS01 Buscar Clienta. Si no hay hora libre: «extend» CUS06 Registrar Lista de Espera (RF09)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p05-89" value="Si validarSinCruce encuentra otra cita de la misma especialista o del mismo recurso, responde 409 e indica el conflicto (RF08, RN02)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p05-90" value="duracion_min es la de referencia o el tiempo exacto que indica la especialista; v5.2: fecha_hora_fin = inicio + duración y desde ese momento la especialista y el recurso quedan libres; no hay tiempo de limpieza (RN03, IX_CITA_AGENDA_RECURSO). La cita la registra siempre recepción (CITA.id_usuario obligatorio). El adelanto es CUS07." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p05-91" value="[It. 2 · RN49, RN51] ServicioCita rechaza con 422 una cita cuya fecha y hora ya pasaron (RN49). Las horas libres se ofrecen cada AGENDA_PASO_MIN minutos desde la apertura de la sede, leídos de PARAMETRO por ParametroApi (RN51); en la Iteración 1 el paso era la duración de referencia (D-08). La variante se elige de GET /api/v1/servicios (CUS58)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="600" width="330" height="90" as="geometry" /></mxCell><mxCell id="p05-92" value="[It. 2 · v5.1] Si la cita sale de una espera (idEspera), la espera pasa a ASIGNADA con su id_cita en la misma transacción (RF09). Sin idEspera, el flujo es el de la Iteración 1." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="710" width="330" height="90" as="geometry" /></mxCell><mxCell id="p05-93" value="[It. 2.1 · v5.2] Sin tiempo de limpieza: las horas libres y la regla de cruce (Java y PKG_AGENDA) usan el mismo fin para la especialista y para el recurso, el fin del servicio (RN03; cierra D-14)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="820" width="330" height="90" as="geometry" /></mxCell><mxCell id="p05-94" value="[It. 2.1 · nombres] La respuesta trae también los nombres que la pantalla muestra (nunca solo el id): ver la página «Nombres en las respuestas · It. 2.1» (CitaDTO y HoraLibre: nombres de la clienta, la especialista, el servicio y el recurso)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="930" width="330" height="90" as="geometry" /></mxCell><mxCell id="p05-95" value="Diagrama de clases del análisis — Programar Cita" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1768" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p05-96" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1828" width="30" height="60" as="geometry" /></mxCell><mxCell id="p05-97" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1828" width="110" height="80" as="geometry" /></mxCell><mxCell id="p05-98" value="IGU_Agenda" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1978" width="110" height="80" as="geometry" /></mxCell><mxCell id="p05-99" value="ControladorCita" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="677.0" y="1828" width="80" height="80" as="geometry" /></mxCell><mxCell id="p05-100" value="ServicioCita" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="971.0" y="1828" width="80" height="80" as="geometry" /></mxCell><mxCell id="p05-101" value="GestorDisponibilidadAgenda" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1321.0" y="1828" width="80" height="80" as="geometry" /></mxCell><mxCell id="p05-102" value="RepositorioCita" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1321.0" y="1978" width="80" height="80" as="geometry" /></mxCell><mxCell id="p05-103" value="RepositorioListaEspera" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1321.0" y="2128" width="80" height="80" as="geometry" /></mxCell><mxCell id="p05-104" value="ParametroApi" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1615.0" y="1828" width="80" height="80" as="geometry" /></mxCell><mxCell id="p05-105" value="Cita" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1895.0" y="1903" width="80" height="80" as="geometry" /></mxCell><mxCell id="p05-106" value="ListaEspera" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1895.0" y="2053" width="80" height="80" as="geometry" /></mxCell><mxCell id="p05-