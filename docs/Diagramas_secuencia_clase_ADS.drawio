ourcePoint" /><mxPoint x="1755" y="1066" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p24-69" value="oTransaccionDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="1096" as="sourcePoint" /><mxPoint x="935" y="1096" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p24-70" value="oDevolucionDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1126" as="sourcePoint" /><mxPoint x="730" y="1126" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p24-71" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1156" as="sourcePoint" /><mxPoint x="525" y="1156" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p24-72" value="mostrarDevolucion(oDevolucionDTO) [RF106]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1186" as="sourcePoint" /><mxPoint x="320" y="1186" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p24-73" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1246" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p24-74" value="Devuelve por la pasarela los pagos digitales de una venta ya ANULADA con su nota de crédito de forma MEDIO_ORIGINAL (CUS22, CUS23): PagosApi.devolver crea otra TRANSACCION_PASARELA con tipo_operacion = DEVOLUCION e id_transaccion_origen (RF106, RN44). El efectivo se devuelve desde la caja." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p24-75" value="v5: si la clienta eligió SALDO_FAVOR, Oracle abona el monto al anular la venta (PKG_VENTA.al_anular, CUS22), así que este CUS no escribe SALDO_FAVOR_MOV para no duplicar el abono." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p24-76" value="Solo con la autorización de la administradora. ServicioAnulacion (ventas) llega a ServicioPago por la interfaz PagosApi del módulo pagos." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p24-77" value="Diagrama de clases del análisis — Devolver Pago Digital" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1316" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p24-78" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1376" widt