Point x="320" y="750" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p15-44" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p15-45" value="Ciclo habitual = promedio de días entre las atenciones de cada clienta; aparece si los días desde su última ATENCION superan ese ciclo. v5: lo calcula la vista V_CLIENTAS_FUERA_CICLO (RF90)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p15-46" value="Para contactarlas se respeta acepta_comunicaciones = 'S' (RN27)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p15-47" value="Diagrama de clases del análisis — Consultar Clientas Inactivas" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p15-48" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="940" width="30" height="60" as="geometry" /></mxCell><mxCell id="p15-49" value=