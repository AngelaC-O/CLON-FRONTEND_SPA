x="2155" y="1442" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p53-78" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2155" y="1472" as="sourcePoint" /><mxPoint x="1755" y="1472" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p53-79" value="oRolDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1502" as="sourcePoint" /><mxPoint x="730" y="1502" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p53-80" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1532" as="sourcePoint" /><mxPoint x="525" y="1532" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p53-81" value="mostrarPermisos(oRolDTO) [RF78]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1562" as="sourcePoint" /><mxPoint x="320" y="1562" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p53-82" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1622" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p53-83" value="Un solo rol por usuario (RN39). Los permisos del rol definen los módulos que verá al ingresar (RF78); solo la administradora ve costos, márgenes y planilla (RN24)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p53-84" value="v5: el diccionario asigna a CUS53 también ROL, PERMISO y ROL_PERMISO: la administradora ajusta los permisos (módulo + acción) de cada rol. Los cuatro roles y sus permisos iniciales los carga el script." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p53-85" value="Diagrama de clases del análisis — Asignar Rol" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1692" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p53-86" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1752" width="30" height="60" as="geometry" /></mxCell><mxCell id="p53-87" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1752" width="110" height="80" as="geometry" /></mxCell><mxCell id="p53-88" value="IGU_Usuarios" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labe