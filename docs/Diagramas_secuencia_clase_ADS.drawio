mxCell><mxCell id="p42-70" value="SELECT * FROM V_PERSONAL_BAJO_RMV" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1960" y="1216" as="sourcePoint" /><mxPoint x="2155" y="1216" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p42-71" value="filas" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2155" y="1246" as="sourcePoint" /><mxPoint x="1960" y="1246" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p42-72" value="lista&amp;lt;PersonalBajoRmvDTO&amp;gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="1276" as="sourcePoint" /><mxPoint x="935" y="1276" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p42-73" value="oPlanillaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1306" as="sourcePoint" /><mxPoint x="730" y="1306" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p42-74" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1336" as="sourcePoint" /><mxPoint x="525" y="1336" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p42-75" value="mostrarPlanilla(oPlanillaDTO) [RF61]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1366" as="sourcePoint" /><mxPoint x="320" y="1366" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p42-76" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1426" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p42-77" value="Neto = sueldo base + comisiones − faltas − tardanzas − adelantos del mes (RF59). Las comisiones solo se calculan si el esquema de pago las incluye (RF58, RN38)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p42-78" value="El aviso de sueldo menor a la remuneración mínima vigente sale de V_PERSONAL_BAJO_RMV (RF61, RN22). El recibo de cada persona es CUS43." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p42-79" value="Diagrama de clases del análisis — Calcular Planilla" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1496" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p42-80" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" v