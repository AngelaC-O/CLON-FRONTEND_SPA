le="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2155" y="2822" as="sourcePoint" /><mxPoint x="935" y="2822" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-136" value="save(oVenta)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="2852" as="sourcePoint" /><mxPoint x="2770" y="2852" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-137" value="UPDATE VENTA (TRG_VENTA_EFECTOS: UPDATE ATENCION; INSERT INTO MOVIMIENTO_KARDEX, INVENTARIO_SEDE); INSERT INTO COMPROBANTE [CUS19]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2780" y="2882" as="sourcePoint" /><mxPoint x="2975" y="2882" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-138" value="serie, numero" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2975" y="2912" as="sourcePoint" /><mxPoint x="2780" y="2912" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-139" value="oVenta" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2770" y="2942" as="sourcePoint" /><mxPoint x="935" y="2942" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-140" value="emitirComprobante(idComprobante) [CUS19]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="2972" as="sourcePoint" /><mxPoint x="2360" y="2972" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-141" value="oComprobante" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2360" y="3002" as="sourcePoint" /><mxPoint x="935" y="3002" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-142" value="oVentaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="3032" as="sourcePoint" /><mxPoint x="730" y="3032" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-143" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="3062" as="sourcePoint" /><mxPoint x="525" y="3062" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-144" value="mostrarVentaCerrada(oVentaDTO) [RF30]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="3092" as="sourcePoint" /><mxPoint x="320" y="3092" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-145" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="3152" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p18-146" value="Si el servicio atendido usó una sesión de un paquete o membresía (ATENCION.id_cliente_paquete, CUS11), la línea va con precio 0: no se cobra otra vez (RF24, RN36). v5: VENTA_DETALLE ya no guarda id_variante; el servicio se toma de la atención cobrada (CK_VENTA_DETALLE_ITEM)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p18-147" value="Total sin IGV (exonerado en la Amazonía, IGV_PORCENTAJE = 0) menos adelanto y saldo a favor (RF25, RN06). Los pagos digitales solo cuentan con transacción APROBADA de la pasarela; el efectivo no pasa por PagosApi (RF26, RF103, RN42)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p18-148" value="El cierre «include» CUS19 Emitir Comprobante Electrónico (generarComprobante y emitirComprobante) en la misma operación. Si se cobra un paquete, ServicioVenta lo registra por PaqueteClienteApi (RF23). Al pasar la venta a CERRADA, Oracle (TRG_VENTA_EFECTOS → PKG_VENTA.al_cerrar) marca las atenciones COBRADAS y registra la salida de kardex de los productos (RF39, RN18): el backend no lo repite. La venta cerrada queda en el historial de la clienta y en la caja del día (RF30)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p18-149" value="[It. 2 · RN52] CUS modificado: listarPorCobrar trae las atenciones FINALIZADAS sin venta (AtencionApi) y las ventas ABIERTAS de la sede para retomarlas; obtenerVenta da la venta con el estado actual de sus cobros digitales. PagosApi.cobrar guarda la TRANSACCION_PASARELA en su propia transacción (REQUIRES_NEW): un cobro aprobado o rechazado queda aunque la venta no se cierre, y la venta sigue ABIERTA hasta que todos sus pagos digitales estén APROBADOS (D-13, Dudas 8 y 10 del front-end)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="600" width="330" height="90" as="geometry" /></mxCell><mxCell id="p18-150" value="[It. 2.1 · v5.2 · D-22] PagosApi.cobrar guarda id_venta en TRANSACCION_PASARELA (FK_TRANS_PAS_VENTA). obtenerVenta suma los cobros PENDIENTES de la venta (PagosApi.cobrosPendientes, con medio, monto, canal y enlace), así se retoma la venta en otro equipo y se registra el pago aprobado con su idTransaccion (Duda 4 del front-end)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="710" width="330" height="90" as="geometry" /></mxCell><mxCell id="p18-151" value="[It. 2.1 · nombres] La respuesta trae también los nombres que la pantalla muestra (nunca solo el id): ver la página «Nombres en las respuestas · It. 2.1» (AtencionCobrable, VentaDTO, DetalleVentaDTO y PagoVentaDTO)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="820" width="330" height="90" as="geometry" /></mxCell><mxCell id="p18-152" value="Diagrama de clases del análisis — Cobrar Venta" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="3222" width="1400" height="30" as="geometry" /></mxCell><mxCell id="