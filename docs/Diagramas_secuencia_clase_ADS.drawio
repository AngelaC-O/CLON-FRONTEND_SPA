"1"><mxGeometry x="40" y="886" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p61-50" value="tipo = SILLON, ESTACION, CAMILLA, CABINA, MESA_MANICURA, LAVACABEZAS o HIDROTERAPIA (CK_RECURSO_TIPO); minutos_limpieza (hasta 30) bloquea el recurso después de cada servicio (RN03)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p61-51" value="RECURSO es del módulo sedes; ServicioRecurso implementa RecursoApi para agenda y catálogo." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p61-52" value="Diagrama de clases del análisis — Registrar Recurso" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="956" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p61-53" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1016" width="30" height="60" as="geometry" /></mxCell><mxCell id="p61-54" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1016" width="110" height="80" as="geometry" /></mxCell><mxCell id="p61-55" value="IGU_Recursos" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=botto