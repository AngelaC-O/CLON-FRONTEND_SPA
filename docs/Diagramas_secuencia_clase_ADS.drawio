r tipo de documento" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="1532" as="sourcePoint" /><mxPoint x="515" y="1532" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p65-81" value="validar()" style="html=1;align=left;spacingLeft=4;verticalAlign=middle;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525" y="1562" as="sourcePoint" /><mxPoint x="525" y="1578" as="targetPoint" /><Array as="points"><mxPoint x="560" y="1562" /><mxPoint x="560" y="1578" /></Array></mxGeometry></mxCell><mxCell id="p65-82" value="HTTP/PATCH /api/v1/tipos-documento/{idTipoDocumento}: configurarTipoDocumento(idTipoDocumento, oTipoDocumentoDTO) [RN45]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525" y="1608" as="sourcePoint" /><mxPoint x="720" y="1608" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p65-83" value="configurarTipoDocumento(idTipoDocumento, oTipoDocumentoDTO)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="1638" as="sourcePoint" /><mxPoint x="925" y="1638" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p65-84" value="findById(idTipoDocumento)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1668" as="sourcePoint" /><mxPoint x="1745" y="1668" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p65-85" value="oTipoDocumento" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;