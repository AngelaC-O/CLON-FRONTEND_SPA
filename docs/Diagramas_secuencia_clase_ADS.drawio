Point" /><mxPoint x="1130" y="676" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p38-44" value="save(oPersonal)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="706" as="sourcePoint" /><mxPoint x="1335" y="706" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p38-45" value="UPDATE PERSONAL (TRG_PERSONAL_DESACTIVAR: UPDATE USUARIO)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="736" as="sourcePoint" /><mxPoint x="1540" y="736" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p38-46" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="766" as="sourcePoint" /><mxPoint x="1345" y="766" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p38-47" value="oPersonalDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="796" as="sourcePoint" /><mxPoint x="730" y="796" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p38-48" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="826" as="sourcePoint" /><mxPoint x="525" y="826" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p38-49" value="mostrarFicha(oPersonalDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="856" as="sourcePoint" /><mxPoint x="320" y="856" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p38-50" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="916" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p38-51" value="Personal.desactivar() cambia el estado a INACTIVO; la ficha no se borra porque la usan asistencias, planillas y ventas (TRG_PERSONAL_NO_ELIMINAR)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p38-52" value="v5: al pasar a INACTIVO, Oracle revoca la cuenta (TRG_PERSONAL_DESACTIVAR deja el USUARIO INACTIVO, RF53), como dice la hoja «Trazabilidad CUS». Por eso el módulo personal no escribe USUARIO y ya no hace falta el evento PersonalDesactivado: tampoco hay ciclo personal ⇄ seguridad." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p38-53" value="Diagrama de clases del análisis — Desactivar Personal" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="986" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p38-54" value="Administradora" style="shape=umlActor;verticalLabelPosit