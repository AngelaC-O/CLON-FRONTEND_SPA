 y="1887" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p56-99" value="Los métodos de cada clase salen de los mensajes que le llegan en el diagrama de secuencia. Las entidades tienen los atributos exactos de su tabla en el diccionario v5 (columna → atributo camelCase, tipo Oracle → tipo Java)." style="text;html=1;fontSize=11;fontColor=#008000;" vertex="1" parent="1"><mxGeometry x="40" y="1919" width="1600" height="22" as="geometry" /></mxCell><mxCell id="p56-100" value="Administradora" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1957" width="170" height="154" as="geometry" /></mxCell><mxCell id="p56-101" value="+nombres: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="p56-100"><mxGeometry x="0" y="26" width="170" height="20" as="geometry" /></mxCell><mxCell id="p56-102" value="+apellidos: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="p56-100"><mxGeometry x="0" y="46" width="170" height="20" as="geometry" /></mxCell><mxCell id="p56-103" value="+dni: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="p56-100"><mxGeometry x="0" y="66" width="170" height="20" as="geometry" /></mxCell>