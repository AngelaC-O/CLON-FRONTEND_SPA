name="CUS27 Registrar Pedido en Línea" id="p27"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p27-1" value="CUS27 · Registrar Pedido en Línea" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry" /></mxCell><mxCell id="p27-2" value="&lt;b&gt;Módulo:&lt;/b&gt; ventas &amp;nbsp;·&amp;nbsp; &lt;b&gt;Actor:&lt;/b&gt; Clienta &amp;nbsp;·&amp;nbsp; &lt;b&gt;Requerimientos:&lt;/b&gt; RF95 &amp;nbsp;·&amp;nbsp; &lt;b&gt;Reglas:&lt;/b&gt; — &amp;nbsp;·&amp;nbsp; &lt;b&gt;Diccionario v5 — escribe:&lt;/b&gt; ninguna &amp;nbsp;·&amp;nbsp; &lt;b&gt;consulta:&lt;/b&gt; —" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="2000" height="24" as="geometry" /></mxCell><mxCell id="p27-3" value="Clienta" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="30" height="60" as="geometry" /></mxCell><mxCell id="p27-4" value="Registrar Pedido en Línea" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="95" width="300" height="60" as="geometry" /></mxCell><mxCell id="p27-5" value="" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;" edge="1" parent="1" source="p27-3" target="p27-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p27-6" value="Realización&lt;br&gt;Registrar Pedido en Línea" style="ellipse;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="95" width="300" height="60" as="geometry" /></mxCell><mxCell id="p27-7" value="&amp;laquo;trace&amp;raquo;" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="p27-6" target="p27-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p27-8" value="Modelo de requerimientos → Modelo de análisis" style="text;html=1;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="360" height="20" as="geometry" /></mxCell><mxCell id="p27-9" value="Won't Have en la versión 1 (RF95, priorización). El diccionario v5 (27/10/2026) retiró PEDIDO, PEDIDO_DETALLE y PRODUCTO.publicado_en_linea, así que este CUS no tiene tablas ni realización en la versión 1." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="900" height="70" as="geometry" /></mxCell><mxCell id="p27-10" value="Si la dueña sube RF95 al alcance, primero se agregan sus tablas al diccionario y luego se diseña aquí la realización." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="900" height="70" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CUS28 Registrar Proveedor" id="p28"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p28-1" value="CUS28 · Registrar Proveedor" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry" /></mxCell><mxCell id="p28-2" value="&lt;b&gt;Módulo:&lt;/b&gt; inventario &amp;nbsp;·&amp;nbsp; &lt;b&gt;Actor:&lt;/b&gt; Encargada de Almacén &amp;nbsp;·&amp;nbsp; &lt;b&gt;Requ