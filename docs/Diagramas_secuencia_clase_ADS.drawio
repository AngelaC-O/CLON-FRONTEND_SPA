y relative="1" as="geometry"><mxPoint x="925" y="2056" as="sourcePoint" /><mxPoint x="730" y="2056" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p47-99" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="2086" as="sourcePoint" /><mxPoint x="525" y="2086" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p47-100" value="mostrarConciliacion(oConciliacionDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="2116" as="sourcePoint" /><mxPoint x="320" y="2116" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p47-101" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="2176" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p47-102" value="Compara las ventas del sistema con los comprobantes ACEPTADOS por SUNAT (con sus notas de crédito) y con las transacciones, comisiones y abonos de la pasarela (RN31). Una diferencia puede nacer solo en la pasarela (CK_CONC_ITEM_ORIGEN)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p47-103" value="v5.1: la comisión y la fecha de abono salen del reporte de liquidación que la Administradora descarga del panel de Izipay (Excel o CSV) y sube; LectorReporteLiquidacion lo lee y PagosApi.registrarLiquidacion completa TRANSACCION_PASARELA por codigo_operacion (RF105). No hay API pública de liquidación ni job diario. Luego se leen V_PASARELA_LIQUIDACION y V_COMPROBANTES_MES." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p47-104" value="Una sola conciliación por mes para toda la empresa (un único RUC)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p47-105" value="[It. 2 · v5.1] Cada diferencia SIN_JUSTIFICAR se marca JUSTIFICADA (con justificación) o EXCLUIDA; la conciliación se CIERRA cuando no queda ninguna SIN_JUSTIFICAR y ya no cambia (CK_CONCILIACION_CIERRE). Las devoluciones de Yape y Plin hechas a mano (CUS24) se justifican aquí." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="600" width="330" height="90" as="geometry" /></mxCell><mxCell id="p47-106" value="Diagrama de clases del análisis — Conciliar Ventas del Mes" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="2246" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p47-107" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="2306" width="30" height="60" as="geometry" /></mxCell><mxCell id="p47-108" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2306" width="110" height="80" as="geometry" /></mxCell><mxCell id="p47-109" value="IGU_Conciliacion" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2456" width="110" height="80" as="geometry" /></mxCell><mxCell id="p47-110" value="ControladorConciliacion" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="677.0" y="2306" width="80" height="80" as="geometry" /></mxCell><mxCell id="p47-111" value="ServicioConciliacion" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="971.0" y="2306" width="80" height="80" as="geometry" /></mxCell><mxCell id="p47-112" value="VentasConsultaApi" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1321.0" y="2306" width="80" height="80" as="geometry" /></mxCell><mxCell id="p47-113" value="PagosApi" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1321.