dministradora&lt;/td&gt;&lt;td&gt;ventas&lt;/td&gt;&lt;td&gt;RF107&lt;/td&gt;&lt;td&gt;CUS14&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS64&lt;/td&gt;&lt;td&gt;Registrar Sede&lt;/td&gt;&lt;td&gt;Administradora&lt;/td&gt;&lt;td&gt;sedes&lt;/td&gt;&lt;td&gt;RF92&lt;/td&gt;&lt;td&gt;CUS19&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS65&lt;/td&gt;&lt;td&gt;Configurar Parámetro del Negocio&lt;/td&gt;&lt;td&gt;Administradora&lt;/td&gt;&lt;td&gt;seguridad&lt;/td&gt;&lt;td&gt;RF87&lt;/td&gt;&lt;td&gt;CUS14&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS66&lt;/td&gt;&lt;td&gt;Registrar Categoría de Producto&lt;/td&gt;&lt;td&gt;Encargada de Almacén&lt;/td&gt;&lt;td&gt;inventario&lt;/td&gt;&lt;td&gt;RF45&lt;/td&gt;&lt;td&gt;CUS09&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS67&lt;/td&gt;&lt;td&gt;Publicar Canal en Línea&lt;/td&gt;&lt;td&gt;Administradora&lt;/td&gt;&lt;td&gt;sedes&lt;/td&gt;&lt;td&gt;RF94, RF95&lt;/td&gt;&lt;td&gt;CUS19&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="900" height="1580" as="geometry" /></mxCell><mxCell id="p00-3" value="&lt;b&gt;Cada página CUS contiene:&lt;/b&gt;&lt;br&gt;1. Caso de uso y su realización (&amp;laquo;trace&amp;raquo;).&lt;br&gt;2. Diagrama de secuencia (Actor → Navegador → IGU_ → Controlador → Servicio → Entidad / Repositorio → BD Oracle).&lt;br&gt;3. Diagrama de clases del análisis (estereotipos frontera, control y entidad, con multiplicidad a ambos lados).&lt;br&gt;4. Diagrama de clases del diseño (atributos tipados del diccionario v5 y métodos derivados de los mensajes).&lt;br&gt;&lt;br&gt;&lt;b&gt;Páginas generales:&lt;/b&gt; clases del análisis, clases del diseño (dominio) y clases del diseño (capas).&lt;br&gt;&lt;br&gt;&lt;b&gt;Reglas aplicadas:&lt;/b&gt; el actor solo habla con fronteras; una frontera nunca habla con una entidad sin pasar por un control; todo mensaje que recibe una clase es un método de esa clase.&lt;br&gt;&lt;br&gt;&lt;b&gt;Fuentes:&lt;/b&gt; Caso de negocio, Matriz de requerimientos (RF, CUS, RN), Diccionario de datos v5 (55 tablas, 27/10/2026) y arquitectura de la Unidad 1.&lt;br&gt;&lt;br&gt;&lt;b&gt;Diccionario v5 (27/10/2026):&lt;/b&gt; herencia PERSONA → CLIENTE, PERSONAL, PROVEEDOR (total y solapada) y COMPROBANTE → NOTA_CREDITO (total y disjunta), catálogo TIPO_DOCUMENTO y 12 tablas retiradas. CUS17, CUS27 y CUS67 (Won't Have) quedan sin realización porque sus tablas se retiraron.&lt;br&gt;&lt;br&gt;&lt;b&gt;Nombres de los CUS (23/10/2026):&lt;/b&gt; cada CUS es un verbo concreto + un solo objeto del dominio (lenguaje ubicuo), sin «Gestionar» ni «y/o». Los 22 CUS anteriores se separaron en 67 (CUS65 a CUS67 se agregaron para que toda tabla editable tenga un CUS que la escriba); la columna «Venía de» da el CUS anterior. «include» / «extend» entre CUS se indican en las notas y como [CUSxx] en los mensajes." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;rounded=1;fillColor=#FFF0F9;strokeColor=#B70050;spacing=12;" vertex="1" parent="1"><mxGeometry x="980" y="70" width="620" height="560" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CUS01 Buscar Clienta" id="p01"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p01-1" value="CUS01 · Buscar Clienta" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry" /></mxCell><mxCell id="p01-2" value="&lt;b&gt;Módulo:&lt;/b&gt; agenda &amp;nbsp;·&amp;nbsp; &lt;b&gt;Actor:&lt;/b&gt; Recepcionista &amp;nbsp;·&amp;nbsp; &lt;b&gt;Requerimientos:&lt;/b&gt; RF01 &amp;nbsp;·&amp;nbsp; &lt;b&gt;Reglas:&lt;/b&gt; — &amp;nbsp;·&amp;nbsp; &lt;b&gt;Diccionario v5 — escribe:&lt;/b&gt; ninguna &amp;nbsp;·&amp;nbsp; &lt;b&gt;consulta:&lt;/b&gt; PERSONA, CLIENTE" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="2000" height="24" as="geometry" /></mxCell><mxCell id="p01-3" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="30" height="60" as="geometry" /></mxCell><mxCell id="p01-4" value="Buscar Clienta" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="95" width="300" height="60" as="geometry" /></mxCell><mxCell id="p01-5" value="" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;" edge="1" parent="1" source="p01-3" target="p01-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p01-6" value="Realización&lt;br&gt;Buscar Clienta" style="ellipse;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="95" width="300" height="60" as="geometry" /></mxCell><mxCell id="p01-7" value="&amp;laquo;trace&amp;raquo;" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="p01-6" target="p01-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p01-8" value="Modelo de requerimientos → Modelo de análisis" style="text;html=1;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="360" height="20" as="geometry" /></mxCell><mxCell id="p01-9" value="Diagrama de secuencia — Buscar Clienta" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p01-10" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="95.0" y="260" width="30" height="60" as="geometry" /></mxCell><mxCell id="p01-11" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260.0" y="260" width="110" height="80" as="geometry" /></mxCell><mxCell id="p01-12" value="IGU_Clientas" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="465.0" y="260" width="110" height="80" as="geometry" /></mxCell><mxCell id="p01-13" value="ControladorCliente" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="685.0" y="260" width="80" height="80" as="geometry" /></mxCell><mxCell id="p01-14" value="ServicioCliente" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="260" width="80" height="80" as="geometry" /></mxCell><mxCell id="p01-15" value="PersonaApi" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1095.0" y="260" width="80" height="80" as="geometry" /></mxCell><mxCell id="p01-16" value="RepositorioCliente" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300.0" y="260" width="80" height="80" as="geometry" /></mxCell><mxCell id="p01-17" value="BD Oracle" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510.0" y="260" width="70" height="80" as="geometry" /></mxCell><mxCell id="p01-18" value="" style="endArrow=no