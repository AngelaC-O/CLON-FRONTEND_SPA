" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p21-40" value="precioUnitario" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="676" as="sourcePoint" /><mxPoint x="935" y="676" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p21-41" value="calcularTotal(oProformaDTO) [RF31, RN06]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="706" as="sourcePoint" /><mxPoint x="1335" y="706" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p21-42" value="total" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="736" as="sourcePoint" /><mxPoint x="935" y="736" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p21-43" value="oProformaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="766" as="sourcePoint" /><mxPoint x="730" y="766" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p21-44" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="796" as="sourcePoint" /><mxPoint x="525" y="796" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p21-45" value="imprimirProforma(oProformaDTO) [RF31, RN09]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="826" as="sourcePoint" /><mxPoint x="320" y="826" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p21-46" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="886" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p21-47" value="v5: la proforma es una cotización sin valor tributario (RN09): se arma con los precios vigentes del catálogo (variantes, paquetes y promociones) y se imprime sin guardarse; PROFORMA y PROFORMA_DETALLE se retiraron. Por eso la respuesta es 200 y no 201." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p21-48" value="Se usa para servicios grandes (novias, quinceañeras) antes de reservar; cuando la clienta paga, la venta se arma en CUS18." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p21-49" value="Diagrama de clases del análisis — Emitir Proforma" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="956" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p21-50" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1