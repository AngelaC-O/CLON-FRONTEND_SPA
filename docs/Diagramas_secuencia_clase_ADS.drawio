=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="916" as="sourcePoint" /><mxPoint x="2360" y="916" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-64" value="filas" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2360" y="946" as="sourcePoint" /><mxPoint x="1345" y="946" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-65" value="lista&amp;lt;BloqueAgenda&amp;gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="976" as="sourcePoint" /><mxPoint x="1140" y="976" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-66" value="lista&amp;lt;FranjaAgendaDTO&amp;gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="1006" as="sourcePoint" /><mxPoint x="935" y="1006" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-67" value="obtenerPersonas(idsPersona) [RF11]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1036" as="sourcePoint" /><mxPoint x="1950" y="1036" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-68" value="lista&amp;lt;PersonaDTO&amp;gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="1066" as="sourcePoint" /><mxPoint x="935" y="1066" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-69" value="obtenerVariantes(idsVariante)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1096" as="sourcePoint" /><mxPoint x="2155" y="1096" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-70" value="lista&amp;lt;DatosVariante&amp;gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2155" y="1126" as="sourcePoint" /><mxPoint x="935" y="1126" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-71" value="lista&amp;lt;FranjaAgendaDTO&amp;gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1156" as="sourcePoint" /><mxPoint x="730" y="1156" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-72" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1186" as="sourcePoint" /><mxPoint x="525" y="1186" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-73" value="mostrarAgenda(lista) [RF11]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1216" as="sourcePoint" /><mxPoint x="320" y="1216" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p08-74" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1276" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p08-75" value="Vista por día, por especialista y por recurso con franjas libres y ocupadas (RF11). idPersonal e idRecurso son filtros opcionales." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p08-76" value="Cada bloque ocupado termina con el servicio, sin tiempo de limpieza (RN03 v5.2), e incluye las atenciones sin cita en curso (ATENCION)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p08-77" value="[It. 2] CUS modificado: listarFiltros carga las especialistas (PersonalApi) y los recursos (RecursoApi) de la sede para los filtros, y cada franja trae el nombre de la clienta, de la especialista y del servicio (PersonaApi, CatalogoApi), no solo sus id (Duda 2 y diferencia 24 del front-end)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p08-78" value="[It. 2.1 · v5.2] V_AGENDA_BLOQUES llama fin a la columna que antes era fin_con_limpieza; FranjaAgendaDTO deja un solo fin (finServicio se retira) y el front-end ya no pinta el bloque «Limpieza» (RN03)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="600" width="330" height="90" as="geometry" /></mxCell><mxCell id="p08-79" value="[It. 2.1 · nombres] La respuesta trae también los nombres que la pantalla muestra (nunca solo el id): ver la página «Nombres en las respuestas · It. 2.1» (FranjaAgendaDTO.nombreRecurso)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="710" width="330" height="90" as="geometry" /></mxCell><mxCell id="p08-80" value="Diagrama de clases del análisis — Consultar Agenda" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1346" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p08-81" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1406" width="30" height="60" as="geometry" /></mxCell><mxCell id="p08-82" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1406" width="110" height="80" as="geometry" /></mxCell><mxCell id="p08-83" value="IGU_Agenda" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1556" width="110" height="80" as="geometry" /></mxCell><mxCell id="p08-84" value="ControladorCita" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d