ent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1592" as="sourcePoint" /><mxPoint x="525" y="1592" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p58-74" value="mostrarServicio(oServicioDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1622" as="sourcePoint" /><mxPoint x="320" y="1622" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p58-75" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1682" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p58-76" value="Desactivar un servicio es estado = 'INACTIVO' en el mismo cambio de datos (RF83); no se borra porque lo usan citas y ventas." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p58-77" value="v5: HISTORIAL_PRECIO se retiró. TRG_AUD_VARIANTE_SERVICIO registra en AUDITORIA el precio anterior y el nuevo, con el usuario de PKG_SESION y la fecha (RN25, RN29, RF80): no hay @Auditable en Java [It. 2]. Solo la administradora cambia precios." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p58-78" value="[It. 2] listarServicios devuelve los servicios con sus variantes y precios; lo usan CUS05, CUS06, CUS13 y CUS21 para elegir la variante (Duda 2 del front-end)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p58-79" value="Diagrama de clases del análisis — Actualizar Servicio" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1752" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p58-80" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1812" width="30" height="60" as="geometry" /></mxCell><mxCell id="p58-81" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1812" width="110" height="80" as="geometry" /></mxCell><mxCell id="p58-82" value="IGU_Catalogo" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1962" width="110" height="80" as="geometry" /></mxCell><mxCell id="p58-83" value="ControladorCatalogo" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="677.0" y="1812" width="80" height="80" as="geometry" /></mxCell><mxCell id="p58-84" va