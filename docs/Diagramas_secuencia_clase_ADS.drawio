sourcePoint" /><mxPoint x="320" y="1232" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p44-62" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1292" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p44-63" value="Una sola caja ABIERTA por sede y día; las ventas y los adelantos en efectivo se registran en ella (CajaAbiertaProvider)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p44-64" value="monto_inicial = efectivo con el que se empieza el día (RF62)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p44-65" value="[It. 2] CUS modificado: obtenerAbierta dice si la sede tiene caja abierta (200 con la caja o 204 sin ella), para la cabecera y para retomar el cierre sin escribir el código (Duda 10 del front-end)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p44-66" value="Diagrama de clases del análisis — Abrir Caja" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1362" width