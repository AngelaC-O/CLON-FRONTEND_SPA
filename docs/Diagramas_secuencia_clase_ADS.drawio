;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1066" as="sourcePoint" /><mxPoint x="1540" y="1066" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p28-60" value="INSERT INTO PROVEEDOR" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="1096" as="sourcePoint" /><mxPoint x="1745" y="1096" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p28-61" value="idProveedor" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="1126" as="sourcePoint" /><mxPoint x="1550" y="1126" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p28-62" value="oProveedor" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="1156" as="sourcePoint" /><mxPoint x="935" y="1156" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p28-63" value="oProveedorDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1186" as="sourcePoint" /><mxPoint x="730" y="1186" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p28-64" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1216" as="sourcePoint" /><mxPoint x="525" y="1216" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p28-65" value="mostrarProveedor(oProveedorDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1246" as="sourcePoint" /><mxPoint x="320" y="1246" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p28-66" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1306" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p28-67" value="v5: el proveedor es PERSONA JURIDICA con razón social y RUC (TRG_PROVEEDOR_HERENCIA) y luego PROVEEDOR con el mismo id. El RUC es único en PERSONA (UQ_PERSONA_DOCUMENTO)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p28-68" value="El RUC se consulta en APISPERU (TIPO_DOCUMENTO RUC, consulta_api = 'S') para completar la razón social y ver estado y condición; si falla, se registra a mano con origen_datos = MANUAL (RF98, RN45)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p28-69" value="El contacto del RF40 se guarda en la columna nueva PROVEEDOR.contacto; teléfono y correo están en PERSONA." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p28-70" value="Diagrama de clases del análisis — Registrar Proveedor" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1376" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p28-71" value="Encargada de Almacén" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1436" width="30" height="60" as="geometry" /></mxCell><mxCell id="p28-72" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1436" width="110" height="80" as="geometry" /></mxCell><mxCell id="p28-73" value="IGU_Compras" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1586" width="110" height="80" as="geometry" /></mxCell><mxCell id="p28-74" value="ControladorCompra" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="677.0" y="1436" width="80" height="80" as="geometry" /></mxCell><mxCell id="p28-75" value="ServicioCompra" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" paren