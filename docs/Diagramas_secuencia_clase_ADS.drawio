estino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1216" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p40-67" value="v5: CORRECCION_ASISTENCIA se retiró. La administradora corrige la marca en ASISTENCIA y AuditoriaApi (módulo seguridad) guarda en AUDITORIA el valor anterior, el nuevo y el motivo en detalle, con usuario y fecha (RF56, RN23, RN29)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p40-68" value="Solo la administradora corrige marcas; la tardanza se recalcula con las horas corregidas y el horario del día." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p40-69" value="Diagrama de clases del análisis — Corregir Asistencia" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1286" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p40-70" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1346" width="30" height="60" as="geometry" /></mxCell><mxCell id="p40-71" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillCol