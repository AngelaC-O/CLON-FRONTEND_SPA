lientePaquete)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="886" as="sourcePoint" /><mxPoint x="1540" y="886" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p16-54" value="INSERT INTO CLIENTE_PAQUETE" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="916" as="sourcePoint" /><mxPoint x="1745" y="916" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p16-55" value="idClientePaquete" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="946" as="sourcePoint" /><mxPoint x="1550" y="946" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p16-56" value="oClientePaquete" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="976" as="sourcePoint" /><mxPoint x="935" y="976" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p16-57" value="oMembresiaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1006" as="sourcePoint" /><mxPoint x="730" y="1006" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p16-58" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1036" as="sourcePoint" /><mxPoint x="525" y