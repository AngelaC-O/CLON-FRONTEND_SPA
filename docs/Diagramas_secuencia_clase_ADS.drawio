="geometry"><mxPoint x="1755" y="1020" as="sourcePoint" /><mxPoint x="1950" y="1020" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p14-62" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="1050" as="sourcePoint" /><mxPoint x="1755" y="1050" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p14-63" value="oCitaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1080" as="sourcePoint" /><mxPoint x="730" y="1080" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p14-64" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1110" as="sourcePoint" /><mxPoint x="525" y="1110" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p14-65" value="mostrarEstado(oCitaDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1140" as="sourcePoint" /><mxPoint x="320" y="1140" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p14-66" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p14-67" value="Solo se recuerda a clientas con acepta_comunicaciones = 'S' (Ley 29733, RN27); el teléfono sale de PERSONA por PersonaApi." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p14-68" value="v5: la tabla RECORDATORIO se retiró: el envío queda en CITA.fecha_recordatorio (un recordatorio por cita). Si PuertoNotificacion (WhatsApp por la cuenta del equipo en APISPERU) falla, la fecha queda nula y se puede reintentar." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p14-69" value="Diagrama de clases del análisis — Enviar Recordatorio de Cita" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1270" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p14-70" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1330" width="30" height="60" as="geometry" /></mxCell><mxCell id="p14-71" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1330" width="110" height="80" as="geometry" /></mxCell><mxCell id="p14-72" value="IGU_Recordatorios" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1