p36-72" value="v5: primero PERSONA NATURAL con DNI o carnet de extranjería (TRG_PERSONAL_HERENCIA) por PersonaApi y luego PERSONAL con el mismo id. Con DNI se consulta APISPERU (RF97); con carnet, o si la consulta falla, la ficha queda MANUAL (RN45)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p36-73" value="Si la persona ya era clienta, registrarPersona devuelve su id y solo se agrega PERSONAL (jerarquía solapada). Quien cobra FIJO no tiene porcentaje de comisión (CK_PERSONAL_COMISION_MODALIDAD). El usuario del sistema se crea después en CUS52." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p36-74" value="Diagrama de clases del análisis — Registrar Personal" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1526" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p36-75" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1586" width="30" height="60" as="geometry" /></mxCell><mxCell id="p36-76" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1586" width="110" height="80" as="geometry" /></mxCell><mxCell id="p36-77" value="IGU_Personal" style="shape=umlBoundary