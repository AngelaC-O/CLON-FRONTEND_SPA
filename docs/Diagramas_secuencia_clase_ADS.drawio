</mxGeometry></mxCell><mxCell id="p13-66" value="idAtencion" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2155" y="1096" as="sourcePoint" /><mxPoint x="1755" y="1096" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p13-67" value="oAtencion" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="1126" as="sourcePoint" /><mxPoint x="1140" y="1126" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p13-68" value="idAtencion" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="1156" as="sourcePoint" /><mxPoint x="935" y="1156" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p13-69" value="crearDesdeAtencion(idAtencion) [CUS18]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1186" as="sourcePoint" /><mxPoint x="1950" y="1186" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p13-70" value="oVentaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="1216" as="sourcePoint" /><mxPoint x="935" y="1216" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p13-71" value="registrarPagos(idVenta, oPagosDTO) [CUS18, RN52]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1246" as="sourcePoint" /><mxPoint x="1950" y="1246" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p13-72" value="oVentaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="1276" as="sourcePoint" /><mxPoint x="935" y="1276" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p13-73" value="cerrar(idVenta, oCierreVentaDTO) [RF20, CUS19]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1306" as="sourcePoint" /><mxPoint x="1950" y="1306" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p13-74" value="oVentaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="1336" as="sourcePoint" /><mxPoint x="935" y="1336" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p13-75" value="oVentaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1366" as="sourcePoint" /><mxPoint x="730" y="1366" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p13-76" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1396" as="sourcePoint" /><mxPoint x="525" y="1396" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p13-77" value="mostrarComprobante(oVentaDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1426" as="sourcePoint" /><mxPoint x="320" y="1426" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p13-78" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1486" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p13-79" value="Cliente de paso: solo nombre_cliente_paso con id_cliente nulo (v5 retiró la bandera es_cliente_paso; CK_ATENCION_CLIENTE); su ficha se completa después con CUS02 o CUS04 si él lo desea (RF19, RN35)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p13-80" value="Atención, cobro y comprobante en una sola pantalla y transacción, con 6 clics o menos (RF20, RNF29). ServicioVentaRapida «include» CUS18 Cobrar Venta y CUS19 Emitir Comprobante Electrónico." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p13-81" value="ServicioVentaRapida es del módulo ventas (Unidad 1, C3.1); la atención la registra agenda a través de AtencionApi." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p13-82" value="[It. 2 · RN52] Con pago digital que la pasarela aún no aprueba (Izipay real devuelve un enlace o un QR), la atención y la venta quedan registradas, la venta queda ABIERTA y la respuesta es 202 con el cobro pendiente; cuando el webhook lo aprueba, la recepcionista cierra la venta con POST /ventas/{idVenta}/cierre (CUS18 y CUS19). Resuelve DF-51." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="600" width="330" height="90" as="geometry" /></mxCell><mxCell id="p13-83" value="[It. 2.1 · v5.2 · D-22] El cobro digital de la venta rápida guarda id_venta en TRANSACCION_PASARELA (PagosApi.cobrar), así la venta que queda ABIERTA lista su cobro PENDIENTE en GET /ventas/{idVenta}." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="710" width="330" height="90" as="geometry" /></mxCell><mxCell id="p13-84" value="[It. 2.1 · nombres] La respuesta trae también los nombres que la pantalla muestra (nunca solo el id): ver la página «Nombres en las respuestas · It. 2.1» (HoraLibre de GET /ventas/rapidas/libres: especialistas y recursos con su nombre)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="820" width="330" height="90" as="geometry" /></mxCell><mxCell id="p13-85" value="Diagrama de clases del análisis — Registrar Atención sin Cita" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1556" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p13-86" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1616" width="30" height="60" as="geometry" /></mxCell><mxCell id="p13-87" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1616" width="110" height="80" as="geometry" /></mxCell><mxCell id="p13-88" value="IGU_VentaRapida" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1766" width="110" height="80" as="geometry" /></mxCell><mxCell id="p13-89" value="ControladorVentaRapida" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="677.0" y="1616" width="80" height="80" as="geometry" /></mxCell><mxCell id="p13-90" value="ServicioVentaRapida" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="971.0" y="1616" width="80" height="80" as="geometry" /></mxCell><mxCell id="p13-91" value="AtencionApi" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1279.0" y="1616" width="80" height="80" as="geometry" /></mxCell><mxCell id="p13-92" value="Se