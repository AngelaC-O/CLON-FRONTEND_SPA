/><mxPoint x="925" y="586" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-47" value="esAdministradora(idUsuarioAutoriza) [RF32, RN32]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="616" as="sourcePoint" /><mxPoint x="1130" y="616" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-48" value="true" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="646" as="sourcePoint" /><mxPoint x="935" y="646" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-49" value="findById(idVenta)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="676" as="sourcePoint" /><mxPoint x="1540" y="676" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-50" value="SELECT * FROM VENTA, COMPROBANTE, NOTA_CREDITO" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="706" as="sourcePoint" /><mxPoint x="1950" y="706" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-51" value="filas" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="736" as="sourcePoint" /><mxPoint x="1550" y="736" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-52" value="oVenta" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="766" as="sourcePoint" /><mxPoint x="935" y="766" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-53" value="emitirNotaCredito(idVenta, oAnulacionDTO) [CUS23]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="796" as="sourcePoint" /><mxPoint x="1745" y="796" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-54" value="oNotaCredito" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="826" as="sourcePoint" /><mxPoint x="935" y="826" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-55" value="anular(idUsuarioAutoriza) [RF32, RF34, RF106, RN12, RN33, RN44]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="856" as="sourcePoint" /><mxPoint x="1335" y="856" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-56" value="save(oVenta)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="886" as="sourcePoint" /><mxPoint x="1540" y="886" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-57" value="UPDATE VENTA (TRG_VENTA_EFECTOS: UPDATE ATENCION, CLIENTE_PAQUETE; INSERT INTO SALDO_FAVOR_MOV, MOVIMIENTO_KARDEX, INVENTARIO_SEDE)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="916" as="sourcePoint" /><mxPoint x="1950" y="916" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-58" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="946" as="sourcePoint" /><mxPoint x="1550" y="946" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-59" value="oVentaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="976" as="sourcePoint" /><mxPoint x="730" y="976" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-60" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1006" as="sourcePoint" /><mxPoint x="525" y="1006" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-61" value="mostrarVentaAnulada(oVentaDTO) [RF34]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1036" as="sourcePoint" /><mxPoint x="320" y="1036" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-62" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1096" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p22-63" value="v5: la venta se anula solo con su nota de crédito emitida («include» CUS23), salvo que SUNAT haya RECHAZADO el comprobante. La nota es una fila NC_BOLETA o NC_FACTURA de COMPROBANTE más su fila NOTA_CREDITO." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p22-64" value="Todo en una transacción: el backend pasa la venta a ANULADA y Oracle (TRG_VENTA_EFECTOS → PKG_VENTA.al_anular) devuelve la atención a FINALIZADA, deja ANULADO el paquete vendido, abona como saldo a favor lo usado (y el total si la forma es SALDO_FAVOR) y reingresa los productos al kardex (RN12, RN33, RN44). La venta nunca se elimina y sale de reportes, caja y conciliación (RF34)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p22-65" value="Exige motivo y la autorización de la administradora (RF32, RN32). La forma de devolución se elige aquí (RF106): con SALDO_FAVOR el abono lo registra Oracle al anular (un abono a mano se rechaza con -20063); con MEDIO_ORIGINAL y pago con tarjeta, Yape o Plin, sigue CUS24 Devolver Pago Digital («extend»)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p22-66" value="Diagrama de clases del análisis — Anular Venta" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1166" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p22-67" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;h