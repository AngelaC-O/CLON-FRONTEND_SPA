eometry relative="1" as="geometry"><mxPoint x="2360" y="1140" as="sourcePoint" /><mxPoint x="1960" y="1140" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p03-72" value="lista&amp;lt;ClientePaquete&amp;gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="1170" as="sourcePoint" /><mxPoint x="935" y="1170" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p03-73" value="productosComprados(idCliente)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1200" as="sourcePoint" /><mxPoint x="2155" y="1200" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p03-74" value="lista&amp;lt;ProductoCompradoDTO&amp;gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2155" y="1230" as="sourcePoint" /><mxPoint x="935" y="1230" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p03-75" value="oFichaClienteDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1260" as="sourcePoint" /><mxPoint x="730" y="1260" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p03-76" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1290" as="sourcePoint" /><mxPoint x="525" y="1290" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p03-77" value="mostrarFicha(oFichaClienteDTO) [RF02]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1320" as="sourcePoint" /><mxPoint x="320" y="1320" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p03-78" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p03-79" value="La ficha reúne datos de contacto (PERSONA, por PersonaApi), historial de servicios, productos comprados, citas pendientes, sesiones pendientes de paquetes o membresía y saldo a favor (RF02)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p03-80" value="v5: las sesiones usadas se cuentan en ATENCION.id_cliente_paquete y la vista V_SESIONES_PAQUETE da las pendientes (RN36); el saldo a favor no se guarda: lo suma V_SALDO_FAVOR_CLIENTE desde SALDO_FAVOR_MOV y no vence (RN05)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p03-81" value="Los productos comprados vienen del módulo ventas por VentasConsultaApi; agenda no lee VENTA. Desde la ficha se pasa a CUS04 Actualizar Clienta." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p03-82" value="Diagrama de clases del análisis — Consultar Ficha de Clienta" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1450" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p03-83" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1510" width="30" height="60" as="geometry" /></mxCell><mxCell id="p03-84" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1510" width="110" height="80" as="geometry" /></mxCell><mxCell id="p03-85" value="IGU_Clientas" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1660" width="110" height="80" as="geometry" /></mxCell><mxCell id="p03-86" value="ControladorCliente" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="677.0" y="1510" width="80" height="80" as="geometry" /></mxCell><mxCell id="p03-87" value="ServicioCliente" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;ve