(RF98, RN45)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p28-69" value="El contacto del RF40 se guarda en la columna nueva PROVEEDOR.contacto; teléfono y correo están en PERSONA." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p28-70" value="Diagrama de clases del análisis — Registrar Proveedor" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1376" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p28-71" value="Encargada de Almacén" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1436" width="30" height="60" as="geometry" /></mxCell><mxCell id="p28-72" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1436" width="110" height="80" as="geometry" /></mxCell><mxCell id="p28-73" value="IGU_Compras" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1586" width="110" height="80" as="geometry" /></mxCell><mxCell id="p28-74" value="ControladorCompra" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1