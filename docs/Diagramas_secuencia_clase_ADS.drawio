destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1606" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p52-83" value="Solo la administradora crea usuarios (RF81); cada usuario nace con un rol (RN39) y debe_cambiar_clave = 'S'." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p52-84" value="El cambio de rol posterior es CUS53 Asignar Rol." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p52-85" value="[It. 2] CUS modificado (D-06): listarPersonalSinUsuario muestra el personal ACTIVO que aún no tiene cuenta. PersonalApi da los id y el cargo; el nombre lo pone PersonaApi en seguridad, porque personal no puede usar PersonaApi sin crear el ciclo seguridad ⇄ personal (DF-23)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p52-86" value="Diagrama de clases del análisis — Registrar Usuario" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1676" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p52-87" value="Administradora" style="shape=umlAct