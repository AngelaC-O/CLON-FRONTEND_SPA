"><mxPoint x="1755" y="1156" as="sourcePoint" /><mxPoint x="2565" y="1156" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-75" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2565" y="1186" as="sourcePoint" /><mxPoint x="1755" y="1186" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-76" value="oNotaCredito" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="1216" as="sourcePoint" /><mxPoint x="935" y="1216" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-77" value="oVentaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1246" as="sourcePoint" /><mxPoint x="730" y="1246" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-78" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1276" as="sourcePoint" /><mxPoint x="525" y="1276" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-79" value="mostrarNotaCredito(oVentaDTO) [RF33]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1306" as="sourcePoint" /><mxPoint x="320" y="1306" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-80" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1366" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p23-81" value="«include» de CUS22 Anular Venta: la administradora autoriza y el sistema emite la nota de crédito electrónica que respalda la anulación (RF33)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2710" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p23-82" value="v5: NotaCredito es subtipo de Comprobante (herencia JOINED, PK compartida). Al guardarla, JPA inserta primero la fila NC_BOLETA o NC_FACTURA de COMPROBANTE (serie BC01 o FC01, número de la BD, estado SUNAT) y luego NOTA_CREDITO (motivo, forma de devolución y autorizaciones). TRG_NOTA_CREDITO_HERENCIA exige que anule el documento de la misma clase y UQ_COMPROBANTE_VENTA_CLASE, una sola nota por venta." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2710" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p23-83" value="Se envía a SUNAT por APISPERU como el comprobante de CUS19 (RN47). Si no responde, queda PENDIENTE y la reenvía ReenvioCpeJob (RN46)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2710" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p23-84" value="Diagrama de clases del análisis — Emitir Nota de Crédito" style="text;html=1;align=left;verticalAl