try relative="1" as="geometry"><mxPoint x="935" y="1216" as="sourcePoint" /><mxPoint x="1540" y="1216" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p36-65" value="INSERT INTO PERSONAL, PERSONAL_AREA, HORARIO_PERSONAL" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="1246" as="sourcePoint" /><mxPoint x="1745" y="1246" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p36-66" value="idPersonal" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="1276" as="sourcePoint" /><mxPoint x="1550" y="1276" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p36-67" value="oPersonal" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="1306" as="sourcePoint" /><mxPoint x="935" y="1306" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p36-68" value="oPersonalDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1336" as="sourcePoint" /><mxPoint x="730" y="1336" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p36-69" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1366" as="sourcePoint" /><mxPoint x="525" y="1366" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p36-70" value="mostrarFicha(oPersonalDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1396" as="sourcePoint" /><mxPoint x="320" y="1396" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p36-71" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1456" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p36-72" value="v5: primero PERSONA NATURAL con DNI o carnet de extranjería (TRG_PERSONAL_HERENCIA) por PersonaApi y luego PERSONAL con el mismo id. Con DNI se consulta APISPERU (RF97); con carnet, o si la consulta falla, la ficha queda MANUAL (RN45)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p36-73" value="Si la persona ya era clienta, registrarPersona devuelve su id y solo se agrega PERSONAL (jerarquía solapada). Quien cobra FIJO no tiene porcentaje de comisión (CK_PERSONAL_COMISION_MODALIDAD). El usuario del sistema se crea después en CUS52." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p36-74" value="Diagrama de clases del análisis — Registrar Personal" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><