20" as="sourcePoint" /><mxPoint x="320" y="720" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p51-46" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p51-47" value="Rama alterna: tras 30 minutos sin actividad la IGU vence la sesión (vencerPorInactividad) y llama al mismo cerrarSesion (RF79)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p51-48" value="El token de la sesión queda invalidado; un nuevo ingreso es CUS50." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p51-49" value="Diagrama de clases del análisis — Cerrar Sesión" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p51-50" value="Personal del Spa" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="910" width="30" height="60" as="geometry" /></mxCell><mxCell id="p51-51" value="Navegador" style="shape=umlBoundary;whiteSpace=