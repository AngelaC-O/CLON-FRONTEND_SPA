IA_PRODUCTO" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="796" as="sourcePoint" /><mxPoint x="1540" y="796" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p66-48" value="idCategoria" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="826" as="sourcePoint" /><mxPoint x="1345" y="826" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p66-49" value="oCategoria" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="856" as="sourcePoint" /><mxPoint x="935" y="856" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p66-50" value="oCategoriaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="886" as="sourcePoint" /><mxPoint x="730" y="886" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p66-51" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="916" as="sourcePoint" /><mxPoint x="525" y="916" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p66-52" value="mostrarCategoria(oCategoriaDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="946" as="sourcePoint" /><mxPo