ry"><mxPoint x="935" y="1216" as="sourcePoint" /><mxPoint x="1745" y="1216" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p26-74" value="oComprobante" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="1246" as="sourcePoint" /><mxPoint x="935" y="1246" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p26-75" value="oVentaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1276" as="sourcePoint" /><mxPoint x="730" y="1276" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p26-76" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1306" as="sourcePoint" /><mxPoint x="525" y="1306" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p26-77" value="mostrarComprobante(oVentaDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1336" as="sourcePoint" /><mxPoint x="320" y="1336" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p26-78" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1396" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p26-79" value="Los productos se eligen con «include» CUS25 Buscar Producto. Con stock cero o insuficiente responde 409 y no vende (RF37, RN15)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p26-80" value="VENTA_DETALLE.id_personal guarda a la especialista que recomendó el producto (RF38); los productos no generan comisión (RN38). Con Yape, Plin o tarjeta el pago se cobra por la pasarela y solo se registra si la transacción queda APROBADA (RF103, RN42, TRG_VENTA_PAGO_REGLAS); en efectivo va a la caja abierta." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p26-81" value="Al cerrar, Oracle (TRG_VENTA_EFECTOS → PKG_VENTA.al_cerrar) registra la salida en MOVIMIENTO_KARDEX ligada a la línea por id_detalle_venta y TRG_KARDEX_APLICAR descuenta INVENTARIO_SEDE (RF39, RN18). La emisión electrónica es «include» CUS19." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p26-82" value="Diagrama de clases del análisis — Vender Producto" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1466" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p26-83" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;lab