ded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="916" as="sourcePoint" /><mxPoint x="525" y="916" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p66-52" value="mostrarCategoria(oCategoriaDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="946" as="sourcePoint" /><mxPoint x="320" y="946" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p66-53" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1006" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p66-54" value="El nombre de la categoría es único (UQ_CATEGORIA_PRODUCTO_NOMBRE); el diccionario da como ejemplo Cabello, Uñas y Spa." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p66-55" value="CUS32 lista las categorías al registrar un producto (RF45) y CUS25 busca productos por categoría (RF35). Viene del CUS09 anterior, que escribía CATEGORIA_PRODUCTO (O-12)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p66-56" value="Diagrama de clases del análisis — 