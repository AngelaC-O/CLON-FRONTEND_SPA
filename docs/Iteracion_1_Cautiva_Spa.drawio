Servicio)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1336" as="sourcePoint" /><mxPoint x="1745" y="1336" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p57-72" value="INSERT INTO SERVICIO, VARIANTE_SERVICIO, SERVICIO_INSUMO" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1755" y="1366" as="sourcePoint" /><mxPoint x="1950" y="1366" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p57-73" value="idServicio" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="1396" as="sourcePoint" /><mxPoint x="1755" y="1396" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p57-74" value="oServicio" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="1426" as="sourcePoint" /><mxPoint x="935" y="1426" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p57-75" value="oServicioDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1456" as="sourcePoint" /><mxPoint x="730" y="1456" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p57-76" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1486" as="sourcePoint" /><mxPoint x="525" y="1486" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p57-77" value="mostrarServicio(oServicioDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1516" as="sourcePoint" /><mxPoint x="320" y="1516" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p57-78" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1576" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p57-79" value="v5: la línea (SALON o SPA) es AREA.linea (la tabla LINEA se retiró, CK_AREA_LINEA) y el tipo de recurso que ocupa el servicio es SERVICIO.tipo_recurso (SERVICIO_RECURSO se retiró): la agenda ofrece los recursos libres de ese tipo (RF06, RF83, RF85)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p57-80" value="Las cinco áreas iniciales las carga el script; el diccionario v5 asigna AREA a este CUS para agregar otra si hace falta. Cada variante tiene precio fijo (RN40) y SERVICIO_INSUMO guarda el consumo estimado de insumos para costear el servicio (RF49). Las especialistas habilitadas salen de PERSONAL_AREA." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p57-81" value="Diagrama de clases del análisis — Registrar Servicio" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1646" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p57-82" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1706" width="30" height="60" as="geometry" /></mxCell><mxCell id="p57-83" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1706" width="110" height="80" as="geometry" /></mxCell><mxCell id="p57-84" value="IGU_Catalogo" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1856" width="110" height="80" as="geometry" /></mxCell><mxCell id="p57-85" value="ControladorCatalogo" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="677.0" y="1706" width="80" height="80" as="geometry" /></mxCell><mxCell id="p57-86" value="ServicioCatalogo" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="971.0" y="1706" width="80" height="80" as="geometry" /></mxCell><mxCell id="p57-87"