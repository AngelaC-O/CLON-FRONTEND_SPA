alue="mostrarRecurso(oRecursoDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="826" as="sourcePoint" /><mxPoint x="320" y="826" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p61-49" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="886" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p61-50" value="tipo = SILLON, ESTACION, CAMILLA, CABINA, MESA_MANICURA, LAVACABEZAS o HIDROTERAPIA (CK_RECURSO_TIPO); minutos_limpieza (hasta 30) bloquea el recurso después de cada servicio (RN03)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p61-51" value="RECURSO es del módulo sedes; ServicioRecurso implementa RecursoApi para agenda y catálogo." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p61-52" value="Diagrama de clases del análisis — Registrar Recurso" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="956" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p61-53" value="Administradora" style="shape=umlActor;