e=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1486" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p13-79" value="Cliente de paso: solo nombre_cliente_paso con id_cliente nulo (v5 retiró la bandera es_cliente_paso; CK_ATENCION_CLIENTE); su ficha se completa después con CUS02 o CUS04 si él lo desea (RF19, RN35)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p13-80" value="Atención, cobro y comprobante en una sola pantalla y transacción, con 6 clics o menos (RF20, RNF29). ServicioVentaRapida «include» CUS18 Cobrar Venta y CUS19 Emitir Comprobante Electrónico." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p13-81" value="ServicioVentaRapida es del módulo ventas (Unidad 1, C3.1); la atención la registra agenda a través de AtencionApi." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p13-82" value="Diagrama de clases del análisis — Registrar Atención sin Cita" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1556" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p13-83" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1616" w