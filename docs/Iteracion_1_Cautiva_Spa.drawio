ive="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="i_conc-516" value="aplica a (N:M)" style="html=1;rounded=0;endArrow=none;strokeColor=#CC0000;strokeWidth=2;labelBackgroundColor=#ffffff;fontColor=#CC0000;fontSize=11;fontStyle=1;" edge="1" parent="1" source="i_conc-87" target="i_conc-76"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="i_conc-517" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=11;fontStyle=1;" vertex="1" connectable="0" parent="i_conc-516"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="i_conc-518" value="0..*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=11;fontStyle=1;" vertex="1" connectable="0" parent="i_conc-516"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="i_conc-519" value="incluye (N:M)" style="html=1;rounded=0;endArrow=none;strokeColor=#CC0000;strokeWidth=2;labelBackgroundColor=#ffffff;fontColor=#CC0000;fontSize=11;fontStyle=1;" edge="1" parent="1" source="i_conc-95" target="i_conc-76"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="i_conc-520" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=11;fontStyle=1;" vertex="1" connectable="0" parent="i_conc-519"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="i_conc-521" value="0..*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=11;fontStyle=1;" vertex="1" connectable="0" parent="i_conc-519"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="i_conc-522" value="&lt;b&gt;Notas:&lt;/b&gt; CITA se reprograma en otra CITA (relación reflexiva 0..1 : 0..*). USUARIO registra además CITA, LISTA_ESPERA, VENTA y CAJA (responsable de auditoría, RN29); solo se dibujan las de AUDITORIA, VENTA y CAJA para no saturar. Relaciones dibujadas: 80." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="1800" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="BD · Modelo lógico-relacional · It. 1" id="i_log"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="i_log-1" value="Modelo lógico / relacional de BD (Oracle) — Iteración 1: 44 tablas; las relaciones N:M se rompen con tablas intermedias" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="40" as="geometry" /></mxCell><mxCell id="i_log-2" value="&lt;b&gt;Leyenda:&lt;/b&gt; &lt;span style='background:#fff2cc;border:1px solid #d6b656'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; la escriben los CUS de la Iteración 1 (28) &amp;nbsp; &lt;span style='background:#e1d5e7;border:1px solid #9673a6'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; datos iniciales del script: la leen los CUS de la iteración o la exige una FK obligatoria (su CUS llega en la Iteración 2 o 3) (11) &amp;nbsp; &lt;span style='background:#f5f5f5;border:1px solid #999999'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; solo estructura, vacía en la Iteración 1 (la exige una FK o un trigger) (5) &amp;nbsp; · &amp;nbsp; &lt;b&gt;borde rojo grueso&lt;/b&gt; = tabla intermedia que rompe una N:M. Columnas, tipos, PK y FK exactos del diccionario v5; pata de gallo: ‖ = obligatorio (FK NOT NULL), ○| = opcional (FK nula), ○&amp;lt; = cero o muchos." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1800" height="40" as="geometry" /></mxCell><mxCell id="i_log-3" value="Módulo seguridad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1050.4" height="858" as="geometry" /></mxCell><mxCell id="i_log-4" value="USUARIO" style="shape=table;startSize=34;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60.0" y="175" width="259.0" height="238" as="geometry" /></mxCell><mxCell id="i_log-5" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;html=1;" vertex="1" parent="i_log-4"><mxGeometry x="0" y="34" width="259.0" height="18" as="geometry" /></mxCell><mxCell id="i_log-6" value="PK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;overflow=hidden;html=1;fontSize=10;" vertex="1" parent="i_log-5"><mxGeometry x="0" y="0" width="46" height="18" as="geometry" /></mxCell><mxCell id="i_log-7" value="id_usuario NUMBER IDENTITY NN" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;html=1;fontSize=10;fontStyle=4;" vertex="1" parent="i_log-5"><mxGeometry x="46" y="0" width="213.0" height="18" as="geometry" /></mxCell><mxCell id="i_log-8" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;html=1;" vertex="1" parent="i_log-4"><mxGeometry x="0" y="52" width="259.0" height="18" as="geometry" /></mxCell