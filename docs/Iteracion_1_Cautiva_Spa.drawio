ge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1262" as="sourcePoint" /><mxPoint x="525" y="1262" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-66" value="mostrarCita(oCitaDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1292" as="sourcePoint" /><mxPoint x="320" y="1292" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p05-67" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1352" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p05-68" value="La clienta se elige con «include» CUS01 Buscar Clienta. Si no hay hora libre: «extend» CUS06 Registrar Lista de Espera (RF09)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p05-69" value="Si validarSinCruce encuentra otra cita de la misma especialista o del mismo recurso, responde 409 e indica el conflicto (RF08, RN02)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p05-70" value="duracion_min es la de referencia o el tiempo exacto que indica la especialista; v5: fecha_hora_fin = inicio + duración, y la limpieza del recurso la suma la regla de cruce con RECURSO.minutos_limpieza (RN03, IX_CITA_AGENDA_RECURSO). La cita la registra siempre recepción (CITA.id_usuario obligatorio). El adelanto es CUS07." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p05-71" value="Diagrama de clases del análisis — Programar Cita" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1422" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p05-72" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1482" width="30" height="60" as="geometry" /></mxCell><mxCell id="p05-73" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1482" width="110" height="80" as="geometry" /></mxCell><mxCell id="p05-74" value="IGU_Agenda" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1632" width="110" height="80" as="geometry" /></mxCell><mxCell id="p05-75" value="ControladorCita" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="677.0" y="1482" width="80" height="80" as