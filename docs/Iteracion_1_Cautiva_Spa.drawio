em &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="886" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p21-47" value="v5: la proforma es una cotización sin valor tributario (RN09): se arma con los precios vigentes del catálogo (variantes, paquetes y promociones) y se imprime sin guardarse; PROFORMA y PROFORMA_DETALLE se retiraron. Por eso la respuesta es 200 y no 201." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p21-48" value="Se usa para servicios grandes (novias, quinceañeras) antes de reservar; cuando la clienta paga, la venta se arma en CUS18." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p21-49" value="Diagrama de clases del análisis — Emitir Proforma" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="956" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p21-50" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1016" width="30" height="60" as="geometry" /></mxCell><mxCell id="p21-51" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPositio