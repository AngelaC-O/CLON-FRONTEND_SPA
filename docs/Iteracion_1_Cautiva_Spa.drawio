geometry"><mxPoint x="1345" y="660" as="sourcePoint" /><mxPoint x="1540" y="660" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p01-44" value="filas" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="690" as="sourcePoint" /><mxPoint x="1345" y="690" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p01-45" value="lista&amp;lt;Cliente&amp;gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="720" as="sourcePoint" /><mxPoint x="935" y="720" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p01-46" value="lista&amp;lt;ClienteDTO&amp;gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="750" as="sourcePoint" /><mxPoint x="730" y="750" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p01-47" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="780" as="sourcePoint" /><mxPoint x="525" y="780" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p01-48" value="mostrarResultados(lista) [RF01]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="810" as="sourcePoint" /><mxPoint x="320" y="810" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p01-49" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p01-50" value="Si no hay resultados, la IGU ofrece registrar una clienta nueva: «extend» CUS02 Registrar Clienta (RF01)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p01-51" value="v5: nombres y teléfono están en el supertipo PERSONA (módulo seguridad). agenda los busca por PersonaApi y solo lee CLIENTE con los mismos id (PK compartida): ningún módulo lee las tablas de otro." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p01-52" value="CUS01 se incluye en CUS03, CUS04, CUS05 y CUS18 para elegir a la clienta." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p01-53" value="Diagrama de clases del análisis — Buscar Clienta" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p01-54" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineCon