" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1172" as="sourcePoint" /><mxPoint x="1745" y="1172" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p45-66" value="UPDATE CAJA; INSERT INTO CAJA_ARQUEO, CAJA_EGRESO" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1755" y="1202" as="sourcePoint" /><mxPoint x="1950" y="1202" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p45-67" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="1232" as="sourcePoint" /><mxPoint x="1755" y="1232" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p45-68" value="oCaja" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="1262" as="sourcePoint" /><mxPoint x="935" y="1262" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p45-69" value="oCajaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1292" as="sourcePoint" /><mxPoint x="730" y="1292" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p45-70" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1322" as="sourcePoint" /><mxPoint x="525" y="1322" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p45-71" value="mostrarCierre(oCajaDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1352" as="sourcePoint" /><mxPoint x="320" y="1352" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p45-72" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1412" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p45-73" value="Los egresos de efectivo del día (CAJA_EGRESO: concepto y monto, por ejemplo una devolución en efectivo) se restan del efectivo esperado (RF63). El esperado sale de las ventas cerradas no anuladas (RF63, RN33). El efectivo se cuenta en caja; Yape, Plin y tarjeta se toman de la pasarela (transacciones APROBADAS del día) (RF64, RN42). CAJA_ARQUEO.monto_esperado lo calcula Oracle (V_CAJA_ESPERADO). v5: CAJA ya no tiene columnas de efectivo: lo esperado, lo contado y la diferencia de cada medio, también del efectivo, viven solo en CAJA_ARQUEO." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p45-74" value="Si la diferencia de un medio de pago no es 0, la observación es obligatoria (RF65, RN30). Al cerrar se avisa de los comprobantes aún PENDIENTES de envío (RN46)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p45-75" value="Con la caja cerrada no se admiten ventas nuevas en ese día sin autorización de la administradora (RF66). Los cierres con diferencia los revisa CUS46." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p45-76" value="Diagrama de clases del análisis — Cerrar Caja" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1482" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p45-77" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1542" width="30" height="60" as="geometry" /></mxCell><mxCell id="p45-78" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1542" width="110" height="80" as="geometry" /></mxCell><mxCell id="p45-79" value="IGU_Caja" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1692" width="110" height="80" as="geometry" /></mxCell><mxCell id="p45-80" value="ControladorCaja" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="677.0" y="1542" width="8