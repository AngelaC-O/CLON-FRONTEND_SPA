<mxfile host="app.diagrams.net" agent="Cautiva Spa U2 · Iteración 1" version="24.7.0"><diagram name="00 Iteración 1 · Objetivo y alcance" id="i00"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="i00-1" value="Iteración 1 — Ciclo core en una sede: reserva → atención → cobro con comprobante electrónico" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1600" height="40" as="geometry" /></mxCell><mxCell id="i00-2" value="&lt;b&gt;Objetivo de implementación de la Iteración 1:&lt;/b&gt; al terminar la iteración, en la sede Pichanaki, el personal inicia sesión según su rol; la recepcionista abre la caja, busca o registra a la clienta (PERSONA + CLIENTE) con su documento, el DNI consultado en APISPERU, le programa la cita (o la anota en lista de espera) y asegura la reserva con un adelanto en efectivo o por enlace de Izipay; la especialista registra la atención, con o sin cita; la recepcionista cobra la venta, emite la boleta o factura electrónica en el ambiente de pruebas de APISPERU, la entrega en PDF o por enlace y cierra la caja con su arqueo. La administradora crea usuarios, asigna roles y registra servicios y recursos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Incremental:&lt;/b&gt; se entregan 0 + 20 funcionalidades (20 de 67 CUS). &lt;b&gt;Iterativo:&lt;/b&gt; se recorre el ciclo de vida (negocio → requerimientos → análisis → diseño → implementación → pruebas) por 1.ª vez.&lt;br&gt;&lt;br&gt;&lt;b&gt;Por qué estos 20:&lt;/b&gt; (1) son el proceso core de la Unidad 1 (Reserva → Atención → Cobro, entidad core VENTA); (2) traen todos los CUS con puntaje ≥ 9,10 de la hoja 4 (CUS05–08 y CUS18–21); (3) suman los CUS habilitadores sin los que esos no corren (sesión, usuarios, caja, servicio, recurso, clienta); (4) prueban temprano las tres integraciones externas, que son el mayor riesgo técnico (APISPERU facturación, APISPERU consulta DNI/RUC e Izipay), como pide RES14. Los 20 son PRIMARIOS (puntaje ≥ 6,5)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;rounded=1;fillColor=#FFF0F9;strokeColor=#B70050;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="230" as="geometry" /></mxCell><mxCell id="i00-3" value="&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:12px'&gt;&lt;tr style='background:#FFF0F9'&gt;&lt;th&gt;CUS&lt;/th&gt;&lt;th&gt;Caso de uso&lt;/th&gt;&lt;th&gt;Actor&lt;/th&gt;&lt;th&gt;Módulo&lt;/th&gt;&lt;th&gt;Puntaje (hoja 4)&lt;/th&gt;&lt;th&gt;RF&lt;/th&gt;&lt;th&gt;Página en este archivo&lt;/th&gt;&lt;th&gt;Página en el draw.io general&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS01&lt;/td&gt;&lt;td&gt;Buscar Clienta&lt;/td&gt;&lt;td&gt;Recepcionista&lt;/td&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;7.00&lt;/td&gt;&lt;td&gt;RF01&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS02&lt;/td&gt;&lt;td&gt;Registrar Clienta&lt;/td&gt;&lt;td&gt;Recepcionista&lt;/td&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;7.00&lt;/td&gt;&lt;td&gt;RF03, RF04, RF05, RF97, RF99&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS05&lt;/td&gt;&lt;td&gt;Programar Cita&lt;/td&gt;&lt;td&gt;Recepcionista&lt;/td&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;9.10&lt;/td&gt;&lt;td&gt;RF06, RF07, RF08&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS06&lt;/td&gt;&lt;td&gt;Registrar Lista de Espera&lt;/td&gt;&lt;td&gt;Recepcionista&lt;/td&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;9.10&lt;/td&gt;&lt;td&gt;RF09&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;7&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS07&lt;/td&gt;&lt;td&gt;Registrar Adelanto de Reserva&lt;/td&gt;&lt;td&gt;Recepcionista&lt;/td&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;9.10&lt;/td&gt;&lt;td&gt;RF10, RF104&lt;/td&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS08&lt;/td&gt;&lt;td&gt;Consultar Agenda&lt;/td&gt;&lt;td&gt;Recepcionista&lt;/td&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;9.10&lt;/td&gt;&lt;td&gt;RF11&lt;/td&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS11&lt;/td&gt;&lt;td&gt;Registrar Atención&lt;/td&gt;&lt;td&gt;Especialista Técnica&lt;/td&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;6.50&lt;/td&gt;&lt;td&gt;RF13, RF14, RF15&lt;/td&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;12&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS13&lt;/td&gt;&lt;td&gt;Registrar Atención sin Cita&lt;/td&gt;&lt;td&gt;Recepcionista&lt;/td&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;7.90&lt;/td&gt;&lt;td&gt;RF17, RF18, RF19, RF20&lt;/td&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS18&lt;/td&gt;&lt;td&gt;Cobrar Venta&lt;/td&gt;&lt;td&gt;Recepcionista&lt;/td&gt;&lt;td&gt;ventas&lt;/td&gt;&lt;td&gt;9.50&lt;/td&gt;&lt;td&gt;RF21, RF22, RF23, RF24, RF25, RF26, RF30, RF103&lt;/td&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;19&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS19&lt;/td&gt;&lt;td&gt;Emitir Comprobante Electrónico&lt;/td&gt;&lt;td&gt;Recepcionista&lt;/td&gt;&lt;td&gt;ventas&lt;/td&gt;&lt;td&gt;9.50&lt;/td&gt;&lt;td&gt;RF27, RF28, RF29, RF98, RF100, RF101&lt;/td&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS20&lt;/td&gt;&lt;td&gt;Entregar Comprobante&lt;/td&gt;&lt;td&gt;Recepcionista&lt;/td&gt;&lt;td&gt;ventas&lt;/td&gt;&lt;td&gt;9.50&lt;/td&gt;&lt;td&gt;RF102&lt;/td&gt;&lt;td&gt;13&lt;/td&gt;&lt;td&gt;21&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS21&lt;/td&gt;&lt;td&gt;Emitir Proforma&lt;/td&gt;&lt;td&gt;Recepcionista&lt;/td&gt;&lt;td&gt;ventas&lt;/td&gt;&lt;td&gt;9.50&lt;/td&gt;&lt;td&gt;RF31&lt;/td&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;22&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS44&lt;/td&gt;&lt;td&gt;Abrir Caja&lt;/td&gt;&lt;td&gt;Recepcionista&lt;/td&gt;&lt;td&gt;caja&lt;/td&gt;&lt;td&gt;7.50&lt;/td&gt;&lt;td&gt;RF62&lt;/td&gt;&lt;td&gt;15&lt;/td&gt;&lt;td&gt;45&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS45&lt;/td&gt;&lt;td&gt;Cerrar Caja&lt;/td&gt;&lt;td&gt;Recepcionista&lt;/td&gt;&lt;td&gt;caja&lt;/td&gt;&lt;td&gt;7.50&lt;/td&gt;&lt;td&gt;RF63, RF64, RF65, RF66&lt;/td&gt;&lt;td&gt;16&lt;/td&gt;&lt;td&gt;46&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS50&lt;/td&gt;&lt;td&gt;Iniciar Sesión&lt;/td&gt;&lt;td&gt;Personal del Spa&lt;/td&gt;&lt;td&gt;seguridad&lt;/td&gt;&lt;td&gt;7.10&lt;/td&gt;&lt;td&gt;RF77, RF78&lt;/td&gt;&lt;td&gt;17&lt;/td&gt;&lt;td&gt;51&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS51&lt;/td&gt;&lt;td&gt;Cerrar Sesión&lt;/td&gt;&lt;td&gt;Personal del Spa&lt;/td&gt;&lt;td&gt;seguridad&lt;/td&gt;&lt;td&gt;7.10&lt;/td&gt;&lt;td&gt;RF79&lt;/td&gt;&lt;td&gt;18&lt;/td&gt;&lt;td&gt;52&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS52&lt;/td&gt;&lt;td&gt;Registrar Usuario&lt;/td&gt;&lt;td&gt;Administradora&lt;/td&gt;&lt;td&gt;seguridad&lt;/td&gt;&lt;td&gt;6.50&lt;/td&gt;&lt;td&gt;RF81&lt;/td&gt;&lt;td&gt;19&lt;/td&gt;&lt;td&gt;53&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS53&lt;/td&gt;&lt;td&gt;Asignar Rol&lt;/td&gt;&lt;td&gt;Administradora&lt;/td&gt;&lt;td&gt;seguridad&lt;/td&gt;&lt;td&gt;6.50&lt;/td&gt;&lt;td&gt;RF78, RF81&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;54&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS57&lt;/td&gt;&lt;td&gt;Registrar Servicio&lt;/td&gt;&lt;td&gt;Administradora&lt;/td&gt;&lt;td&gt;catalogo&lt;/td&gt;&lt;td&gt;6.70&lt;/td&gt;&lt;td&gt;RF49, RF83&lt;/td&gt;&lt;td&gt;21&lt;/td&gt;&lt;td&gt;58&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CUS61&lt;/td&gt;&lt;td&gt;Registrar Recurso&lt;/td&gt;&lt;td&gt;Administradora&lt;/td&gt;&lt;td&gt;sedes&lt;/td&gt;&lt;td&gt;6.70&lt;/td&gt;&lt;td&gt;RF85&lt;/td&gt;&lt;td&gt;22&lt;/td&gt;&lt;td&gt;62&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="1200" height="760" as="geometry" /></mxCell><mxCell id="i00-4" value="&lt;b&gt;Plan de iteraciones (67 CUS)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Iteración 1 (20):&lt;/b&gt; CUS01, CUS02, CUS05, CUS06, CUS07, CUS08, CUS11, CUS13, CUS18, CUS19, CUS20, CUS21, CUS44, CUS45, CUS50, CUS51, CUS52, CUS53, CUS57, CUS61&lt;br&gt;&lt;br&gt;&lt;b&gt;Iteración 2 (25):&lt;/b&gt; CUS03, CUS04, CUS09, CUS10, CUS12, CUS22, CUS23, CUS24, CUS25, CUS26, CUS32, CUS33, CUS34, CUS35, CUS46, CUS47, CUS54, CUS55, CUS58, CUS59, CUS60, CUS62, CUS63, CUS65, CUS66&lt;br&gt;Resto de agenda y ventas (ficha, reprogramar, cancelar, anular, nota de crédito, devolución, venta de productos), inventario, cierre y conciliación, auditoría y configuración (catálogo, medios de pago, series, parámetros).&lt;br&gt;&lt;br&gt;&lt;b&gt;Iteración 3 (19):&lt;/b&gt; CUS14, CUS15, CUS16, CUS28, CUS29, CUS30, CUS31, CUS36, CUS37, CUS38, CUS39, CUS40, CUS41, CUS42, CUS43, CUS48, CUS49, CUS56, CUS64&lt;br&gt;Personal, asistencia y planilla, compras, reportes, recordatorios, membresías, incidentes y sedes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Versión 2 (Won't Have, 3):&lt;/b&gt; CUS17, CUS27, CUS67" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;spacing=10;" vertex="1" parent="1"><mxGeometry x="1270" y="310" width="380" height="600" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="01 Casos de uso · Iteración 1" id="i01"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="i01-1" value="Diagrama de casos de uso — Iteración 1 (20 CUS)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry" /></mxCell><mxCell id="i01-2" value="Sistema BackOffice Cautiva Spa · Iteración 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="1220" height="850" as="geometry" /></mxCell><mxCell id="i01-3" value="CUS50&lt;br&gt;Iniciar Sesión" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-4" value="CUS51&lt;br&gt;Cerrar Sesión" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="250" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-5" value="CUS52&lt;br&gt;Registrar Usuario" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="360" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-6" value="CUS53&lt;br&gt;Asignar Rol" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-7" value="CUS57&lt;br&gt;Registrar Servicio" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="580" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-8" value="CUS61&lt;br&gt;Registrar Recurso" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="690" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-9" value="CUS11&lt;br&gt;Registrar Atención" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="800" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-10" value="CUS44&lt;br&gt;Abrir Caja" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="140" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-11" value="CUS05&lt;br&gt;Programar Cita" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="250" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-12" value="CUS01&lt;br&gt;Buscar Clienta" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="360" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-13" value="CUS18&lt;br&gt;Cobrar Venta" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="470" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-14" value="CUS20&lt;br&gt;Entregar Comprobante" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="580" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-15" value="CUS21&lt;br&gt;Emitir Proforma" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="690" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-16" value="CUS45&lt;br&gt;Cerrar Caja" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1130" y="140" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-17" value="CUS06&lt;br&gt;Registrar Lista de Espera" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1130" y="250" width="300" height="64" as="geometry" /></mxCell><mxCell id="i01-18" value="CUS02&lt;br&gt;Registrar Clienta" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1130" y="360" width="300" height="64" as="geometry" /></mxCell><mxC