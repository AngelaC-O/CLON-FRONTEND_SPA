l=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1755" y="1876" as="sourcePoint" /><mxPoint x="3590" y="1876" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p07-114" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3590" y="1906" as="sourcePoint" /><mxPoint x="1755" y="1906" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p07-115" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2565" y="1936" as="sourcePoint" /><mxPoint x="2370" y="1936" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p07-116" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2360" y="1966" as="sourcePoint" /><mxPoint x="2165" y="1966" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p07-117" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="2026" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p07-118" value="Se ejecuta una de las dos ramas: efectivo en recepción o enlace de pago para pagar sin ir al local (RF104)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3735" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p07-119" value="Adelanto digital: la reserva queda asegurada solo cuando la pasarela confirma el cobro (RN04, RN42); Oracle exige una TRANSACCION_PASARELA APROBADA de la misma cita y por el mismo monto (regla de CITA.adelanto_monto en el diccionario v5). El sistema nunca recibe datos de la tarjeta (RN43)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3735" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p07-120" value="ServicioPago implementa PagosApi (módulo pagos). ManejadorAdelantoConfirmado escucha AdelantoAprobado en la misma transacción. El webhook es idempotente (UQ_TRANS_PAS_CODIGO_OPERACION)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3735" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p07-121" value="Diagrama de clases del análisis — Registrar Adelanto de Reserva" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="2096" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p07-122" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="2156" width="30" height="60" as="geometry" /></mxCell><mxCell id="p07-123" value="Izipay" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fillColor=#f8cecc;strokeColor