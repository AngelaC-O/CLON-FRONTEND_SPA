<mxCell id="p11-92" value="oCita" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="1696" as="sourcePoint" /><mxPoint x="935" y="1696" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p11-93" value="finalizar()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1726" as="sourcePoint" /><mxPoint x="1540" y="1726" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p11-94" value="save(oCita)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1756" as="sourcePoint" /><mxPoint x="1335" y="1756" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p11-95" value="UPDATE CITA" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="1786" as="sourcePoint" /><mxPoint x="2565" y="1786" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p11-96" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2565" y="1816" as="sourcePoint" /><mxPoint x="1345" y="1816" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p11-97" value="oAtencionDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1846" as="sourcePoint" /><mxPoint x="730" y="1846" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p11-98" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1876" as="sourcePoint" /><mxPoint x="525" y="1876" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p11-99" value="mostrarAtencionFinalizada(oAtencionDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1906" as="sourcePoint" /><mxPoint x="320" y="1906" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p11-100" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1966" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p11-101" value="El tiempo declarado al iniciar actualiza el bloque de la agenda (RF13); la cita pasa a EN_ATENCION y al terminar a FINALIZADA (CK_CITA_ESTADO). Al finalizar, el recurso queda bloqueado por su tiempo de limpieza, de hasta 30 minutos (RF14)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2710" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p11-102" value="v5: si el servicio está incluido en un paquete o membresía activa de la clienta, la sesión se descuenta guardando ATENCION.id_cliente_paquete (antes CONSUMO_SESION); las sesiones usadas se cuentan (V_SESIONES_PAQUETE) y esa atención no se cobra ni comisiona (RN36, RN37, RN38, CK_ATENCION_PAQUETE)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2710" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p11-103" value="Las recomendaciones de productos son CUS12; la salida de insumos usados la registra almacén en CUS33 (RF46). La atención sin cita es CUS13." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2710" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p11-104" value="Diagrama de clases del análisis — Registrar Atención" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="2036" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p11-105" value="Especialista Técnica" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="2096" width="30" height="60" as="geometry" /></mxCell><mxCell id="p11-106" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2096" width="110" height="80" as="geometry" /></mxCell><mxCell id="p11-107" value="IGU_Atencion" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2246" width="110" height="80" as="geometry" /></