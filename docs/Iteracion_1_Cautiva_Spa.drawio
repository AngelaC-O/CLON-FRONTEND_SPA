17" value="serie, numero" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2975" y="2266" as="sourcePoint" /><mxPoint x="2780" y="2266" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-118" value="oVenta" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2770" y="2296" as="sourcePoint" /><mxPoint x="935" y="2296" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-119" value="emitirComprobante(idComprobante) [CUS19]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="2326" as="sourcePoint" /><mxPoint x="2360" y="2326" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-120" value="oComprobante" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2360" y="2356" as="sourcePoint" /><mxPoint x="935" y="2356" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-121" value="oVentaDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="2386" as="sourcePoint" /><mxPoint x="730" y="2386" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-122" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="2416" as="sourcePoint" /><mxPoint x="525" y="2416" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-123" value="mostrarVentaCerrada(oVentaDTO) [RF30]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="2446" as="sourcePoint" /><mxPoint x="320" y="2446" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p18-124" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="2506" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p18-125" value="Si el servicio atendido usó una sesión de un paquete o membresía (ATENCION.id_cliente_paquete, CUS11), la línea va con precio 0: no se cobra otra vez (RF24, RN36). v5: VENTA_DETALLE ya no guarda id_variante; el servicio se toma de la atención cobrada (CK_VENTA_DETALLE_ITEM)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p18-126" value="Total sin IGV (exonerado en la Amazonía, IGV_PORCENTAJE = 0) menos adelanto y saldo a favor (RF25, RN06). Los pagos digitales solo cuentan con transacción APROBADA de la pasarela; el efectivo no pasa por PagosApi (RF26, RF103, RN42)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p18-127" value="El cierre «include» CUS19 Emitir Comprobante Electrónico (generarComprobante y emitirComprobante) en la misma operación. Si se cobra un paquete, ServicioVenta lo registra por PaqueteClienteApi (RF23). Al pasar la venta a CERRADA, Oracle (TRG_VENTA_EFECTOS → PKG_VENTA.al_cerrar) marca las atenciones COBRADAS y registra la salida de kardex de los productos (RF39, RN18): el backend no lo repite. La venta cerrada queda en el historial de la clienta y en la caja del día (RF30)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3120" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p18-128" value="Diagrama de clases del análisis — Cobrar Venta" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="2576" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p18-129" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="2636" width="30" height="60" as="geometry" /></mxCell><mxCell id="p18-130" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2636" width="110" height="80" as="geometry" /></mxCell><mxCell id="p18-131" value="IGU_Cobro" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2786" width="110" height="80