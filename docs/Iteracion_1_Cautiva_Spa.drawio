a:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="946" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p06-55" value="«extend» de CUS05 Programar Cita: se usa cuando no hay capacidad en la hora pedida." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p06-56" value="La respuesta trae otras horas libres cercanas para ofrecerlas a la clienta antes de dejarla en espera (RF09)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p06-57" value="Cuando la espera se convierte en cita, LISTA_ESPERA.id_cita guarda la cita creada y el estado cambia." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p06-58" value="Diagrama de clases del análisis — Registrar Lista de Espera" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1016" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p06-59" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;ver