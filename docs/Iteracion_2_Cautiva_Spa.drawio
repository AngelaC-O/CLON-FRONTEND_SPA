=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2155" y="1818" as="sourcePoint" /><mxPoint x="1755" y="1818" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p65-90" value="oTipoDocumentoDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1848" as="sourcePoint" /><mxPoint x="730" y="1848" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p65-91" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1878" as="sourcePoint" /><mxPoint x="525" y="1878" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p65-92" value="mostrarParametro(oParametroDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1908" as="sourcePoint" /><mxPoint x="320" y="1908" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p65-93" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1968" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p65-94" value="PARAMETRO guarda los valores del negocio que cambian: IGV_PORCENTAJE = 0 (RN06), márgenes de 50 % y 100 % (RN14), RMV_MONTO (RN22), umbral de S/700, minutos de limpieza y plazo de envío del CPE. Solo la administradora los cambia (RES28); CK_PARAMETRO_VALOR exige valor_numero o valor_texto." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p65-95" value="v5: CUS65 también mantiene TIPO_DOCUMENTO (Catálogo 06 de SUNAT: DNI, carnet de extranjería, RUC, pasaporte y cédula diplomática). La lista, sus longitudes y su formato los carga el script; aquí se activa o desactiva un tipo y se marca consulta_api (solo DNI y RUC se consultan en APISPERU, RN45). GET /tipos-documento lo usan las IGU de CUS02, CUS04, CUS19, CUS28 y CUS36." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p65-96" value="ServicioParametro implementa ParametroApi (SPI de comun): CUS32 lee el margen (RF87) y ReenvioCpeJob el plazo sin depender de seguridad." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p65-97" value="[It. 2 · RN51] PARAMETRO suma AGENDA_PASO_MIN (minutos entre horas libres, 15 al inicio; script 17). GET /tipos-documento reemplaza la copia fija de los id 1 a 5 en el front-end (Duda 5)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="600" width="330" height="90" as="geometry" /></mxCell><mxCell id="p65-98" value="[It. 2 · v5.1] LIMPIEZA_MAX_MIN pasa a 10 (RN03); el CHECK de RECURSO.minutos_limpieza también limita a 10." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="710" width="330" height="90" as="geometry" /></mxCell><mxCell id="p65-99" value="Diagrama de clases del análisis — Configurar Parámetro del Negocio" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="2038" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p65-100" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="2098" width="30" height="60" as="geometry" /></mxCell><mxCell id="p65-101" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2098" width="110" height="80" as="geometry" /></mxCell><mxCell id="p65-102" value="IGU_Parametros" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2248" width="110" height="80" as="geometry" /></mxCell><mxCell id="p65-103" value="ControladorParametro" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="677.0" y="2098" width="80" height="80" as="geometry" /></mxCell><mxCell id="p65-104" value="ServicioParametro" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366