 x="1345" y="1502" as="sourcePoint" /><mxPoint x="1540" y="1502" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p24-83" value="save(oDevolucion)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="1532" as="sourcePoint" /><mxPoint x="1745" y="1532" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p24-84" value="INSERT INTO TRANSACCION_PASARELA" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1755" y="1562" as="sourcePoint" /><mxPoint x="2360" y="1562" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p24-85" value="idTransaccion" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2360" y="1592" as="sourcePoint" /><mxPoint x="1755" y="1592" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p24-86" value="oTransaccionDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="1622" as="sourcePoint" /><mxPoint x="935" y="1622" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p24-87" value="oDevolucionDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1652" as="sourcePoint" /><mxPoint x="730" y="1652" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p24-88" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1682" as="sourcePoint" /><mxPoint x="525" y="1682" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p24-89" value="mostrarDevolucion(oDevolucionDTO) [RF106]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1712" as="sourcePoint" /><mxPoint x="320" y="1712" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p24-90" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1772" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p24-91" value="Devuelve por la pasarela los pagos digitales de una venta ya ANULADA con su nota de crédito de forma MEDIO_ORIGINAL (CUS22, CUS23): PagosApi.devolver crea otra TRANSACCION_PASARELA con tipo_operacion = DEVOLUCION e id_transaccion_origen (RF106, RN44). El efectivo se devuelve desde la caja." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p24-92" value="v5: si la clienta eligió SALDO_FAVOR, Oracle abona el monto al anular la venta (PKG_VENTA.al_anular, CUS22), así que este CUS no escribe SALDO_FAVOR_MOV para no duplicar el abono." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p24-93" value="Solo con la autorización de la administradora. ServicioAnulacion (ventas) llega a ServicioPago por la interfaz PagosApi del módulo pagos." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p24-94" value="[It. 2 · v5.1] La API de reembolsos de Izipay solo se usa con tarjeta (y solo funciona en producción). Yape y Plin pagados por QR los devuelve la Administradora desde la app y registra aquí la DEVOLUCION (canal QR, APROBADA) con el número de operación de la app; en la conciliación esas devoluciones no figuran en el reporte de Izipay y se justifican (CUS47)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2505" y="600" width="330" height="90" as="geometry" /></mxCell><mxCell id="p24-95" value="Diagrama de clases del análisis — Devolver Pago Digital" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1842" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p24-96" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1902" width="30" height="60" as="geometry" /></mxCell><mxCell id="p24-97" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="36