vertex="1" parent="1"><mxGeometry x="1685" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p66-55" value="CUS32 lista las categorías al registrar un producto (RF45) y CUS25 busca productos por categoría (RF35). Viene del CUS09 anterior, que escribía CATEGORIA_PRODUCTO (O-12)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p66-56" value="Diagrama de clases del análisis — Registrar Categoría de Producto" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1076" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p66-57" value="Encargada de Almacén" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1136" width="30" height="60" as="geometry" /></mxCell><mxCell id="p66-58" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1136" width="110" height="80" as="geometry" /></mxCell><mxCell id="p66-59" value="IGU_Inventario" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1286" width="110" height="80" as="geometry" /></mxCell><mxCell id="p66-60" value="ControladorProducto" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabe