ntSize=11;strokeColor=#1f3a68;fontColor=#1f3a68;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="j02-9" target="j02-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="j02-70" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=11;strokeColor=#1f3a68;fontColor=#1f3a68;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="j02-9" target="j02-65"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="j02-71" value="&amp;laquo;extend&amp;raquo;" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=11;strokeColor=#b85450;fontColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="j02-17" target="j02-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="j02-72" value="&amp;laquo;extend&amp;raquo;" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=11;strokeColor=#b85450;fontColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="j02-10" target="j02-66"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="j02-73" value="solicitud &amp;rarr; bandeja" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=11;strokeColor=#666666;fontColor=#666666;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="j02-7" target="j02-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="j02-74" value="&lt;b&gt;Relaciones (de las notas de cada realización):&lt;/b&gt; CUS03 y CUS04 «include» CUS01 (elegir a la clienta); CUS26 «include» CUS25 (elegir el producto) y CUS19 (comprobante); CUS12 «extend» CUS11 (recomendar durante la atención); CUS24 «extend» CUS23 (devolución del pago digital después de aprobar la anulación). CUS22 registra la solicitud que CUS23 aprueba o rechaza (flecha gris: mismo objeto, distinto actor). Izipay es actor secundario de CUS24 (devolución con tarjeta) y CUS47 (su reporte de liquidación). Los CUS punteados son de la Iteración 1; los 12 CUS modificados de la Iteración 1 mantienen sus actores. Color = módulo: azul agenda, amarillo ventas y pagos, naranja inventario, verde caja, rojo claro reportes, lila catálogo, gris seguridad." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1478" width="1650" height="70" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CUS03 Consultar Ficha de Clienta" id="p03"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p03-1" value="CUS03 · Consultar Ficha de Clienta" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry" /></mxCell><mxCell id="p03-2" value="&lt;b&gt;Módulo:&lt;/b&gt; agenda &amp;nbsp;·&amp;nbsp; &lt;b&gt;Actor:&lt;/b&gt; Recepcionista &amp;nbsp;·&amp;nbsp; &lt;b&gt;Requerimientos:&lt;/b&gt; RF02 &amp;nbsp;·&amp;nbsp; &lt;b&gt;Reglas:&lt;/b&gt; RN05, RN36 &amp;nbsp;·&amp;nbsp; &lt;b&gt;Diccionario v5.1 — escribe:&lt;/b&gt; ninguna &amp;nbsp;·&amp;nbsp; &lt;b&gt;consulta:&lt;/b&gt; PERSONA, CLIENTE, CITA, ATENCION, VENTA, CLIENTE_PAQUETE, V_SALDO_FAVOR_CLIENTE, V_SESIONES_PAQUETE" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="2000" height="24" as="geometry" /></mxCell><mxCell id="p03-3" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="30" height="60" as="geometry" /></mxCell><mxCell id="p03-4" value="Consultar Ficha de Clienta" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="95" width="300" height="60" as="geometry" /></mxCell><mxCell id="p