="752" /></Array></mxGeometry></mxCell><mxCell id="p22-49" value="oSolicitud = new SolicitudAnulacion(idVenta, motivo, codigoMotivo, formaDevolucion, idUsuarioSolicita) [RF32, RN32, RF106]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="782" as="sourcePoint" /><mxPoint x="1335" y="782" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-50" value="save(oSolicitud)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="812" as="sourcePoint" /><mxPoint x="1540" y="812" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-51" value="INSERT INTO SOLICITUD_ANULACION" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="842" as="sourcePoint" /><mxPoint x="1745" y="842" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-52" value="idSolicitud" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="872" as="sourcePoint" /><mxPoint x="1550" y="872" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-53" value="oSolicitud" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="902" as="sourcePoint" /><mxPoint x="935" y="902" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-54" value="oSolicitudAnulacionDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="932" as="sourcePoint" /><mxPoint x="730" y="932" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-55" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="962" as="sourcePoint" /><mxPoint x="525" y="962" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-56" value="mostrarSolicitud(oSolicitudAnulacionDTO) [RF32]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="992" as="sourcePoint" /><mxPoint x="320" y="992" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p22-57" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1052" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p22-58" value="[It. 2 · v5.1] La recepcionista (o la Administradora) registra la solicitud con motivo, código SUNAT (01, 02 o 06) y forma de devolución; queda PENDIENTE en la bandeja de la Administradora. Solo una PENDIENTE por venta (UQ_SOL_ANUL_PENDIENTE, 409) y la venta debe estar CERRADA." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p22-59" value="La anulación (nota de crédito, venta ANULADA y efectos de Oracle) la hace CUS23 al aprobar la solicitud; si se rechaza, la venta sigue CERRADA y la solicitud guarda el motivo del rechazo (RN32). La venta anulada sale de reportes, caja y conciliación (RF34, RN33)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p22-60" value="La forma de devolución se elige aquí (RF106): con SALDO_FAVOR el abono lo hace Oracle al anular; con MEDIO_ORIGINAL y pago digital sigue CUS24 Devolver Pago Digital después de aprobada. Un cliente de paso no puede elegir SALDO_FAVOR (-20077)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p22-61" value="Diagrama de clases del análisis — Anular Venta" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1122" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p22-62" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1182" width="30" height="60" as="geometry" /></mxCell><mxCell id="p22-63" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="1182" width="110" height="80" as="geometry" /></mxCell><mxCell id="p22-64" value="IGU_Anulacion" 