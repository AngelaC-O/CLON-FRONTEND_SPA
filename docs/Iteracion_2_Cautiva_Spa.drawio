shed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2975" y="2642" as="sourcePoint" /><mxPoint x="935" y="2642" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p11-133" value="oAtencionDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="2672" as="sourcePoint" /><mxPoint x="730" y="2672" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p11-134" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="2702" as="sourcePoint" /><mxPoint x="525" y="2702" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p11-135" value="mostrarAtencionFinalizada(oAtencionDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="2732" as="sourcePoint" /><mxPoint x="320" y="2732" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p11-136" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="2792" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p11-137" value="El tiempo declarado al iniciar actualiza el bloque de la agenda (RF13); la cita pasa a EN_ATENCION y al terminar a FINALIZADA (CK_CITA_ESTADO). Al finalizar, el recurso queda bloqueado por su tiempo de limpieza, de hasta 10 minutos (RF14, RN03); si termina antes de lo declarado, la especialista queda libre desde hora_fin [v5.1]." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3325" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p11-138" value="v5: si el servicio está incluido en un paquete o membresía activa de la clienta, la sesión se descuenta guardando ATENCION.id_cliente_paquete (antes CONSUMO_SESION); las sesiones usadas se cuentan (V_SESIONES_PAQUETE) y esa atención no se cobra ni comisiona (RN36, RN37, RN38, CK_ATENCION_PAQUETE)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3325" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p11-139" value="Las recomendaciones de productos son CUS12; la salida de los insumos usados se descuenta sola al finalizar (RN53) y almacén regulariza los pendientes en CUS33. La atención sin cita es CUS13." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3325" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p11-140" value="[It. 2 · RN50] CUS modificado: Mi agenda sale de la sesión (UsuarioActual.idPersonal), no de un selector; solo la especialista asignada, o la administradora, inicia y finaliza la atención (verificarEspecialista, 403). obtenerEnCurso retoma la atención desde otro equipo (Dudas 6 y 7 del front-end)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3325" y="600" width="330" height="90" as="geometry" /></mxCell><mxCell id="p11-141" value="[It. 2 · RN53, RN54] Al finalizar, InventarioApi.registrarConsumoAtencion registra una SALIDA por insumo de la variante (SERVICIO_INSUMO, en su unidad mínima, redondeada hacia arriba) ligada a la atención. Si el stock no alcanza, descuenta lo que hay y deja el resto en CONSUMO_PENDIENTE (aviso para almacén). La atención se finaliza siempre; RN17 admite esta salida automática (TRG_KARDEX_APLICAR v5.1)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3325" y="710" width="330" height="90" as="geometry" /></mxCell><mxCell id="p11-142" value="Diagrama de clases del análisis — Registrar Atención" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="2862" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p11-143" value="Especialista Técnica" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="2922" width="30" height="60" as="geometry" /></mxCell><mxCell id="p11-144" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2922" width="110" height="80" as="geometry" /></mxCell><mxCell id="p11-145" value="IGU_Atencion" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="3072" width="110" height="80" as="geometry" /></mxCell><mxCell 