elBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="1156" as="sourcePoint" /><mxPoint x="1550" y="1156" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p04-63" value="oCliente" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1540" y="1186" as="sourcePoint" /><mxPoint x="935" y="1186" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p04-64" value="oClienteDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1216" as="sourcePoint" /><mxPoint x="730" y="1216" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p04-65" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1246" as="sourcePoint" /><mxPoint x="525" y="1246" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p04-66" value="mostrarFicha(oClienteDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1276" as="sourcePoint" /><mxPoint x="320" y="1276" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p04-67" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1336" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p04-68" value="La consulta del documento es la misma de CUS02 (PersonaApi, módulo seguridad). actualizarPersona cambia los datos comunes en PERSONA; agenda solo cambia los propios de CLIENTE (cumpleaños, observaciones y consentimiento)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p04-69" value="Si el teléfono ya pertenece a otra persona, PersonaApi responde 409 y no se guarda (RF05, UQ_PERSONA_TELEFONO). Si cambia el documento sin una consulta nueva, la BD deja la ficha MANUAL (RN45, RF99)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p04-70" value="También completa la ficha del cliente de paso atendido solo con su nombre (RF19)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p04-71" value="Diagrama de clases del análisis — Actualizar Clienta" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1406" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p04-72" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1466" width="30" height="6