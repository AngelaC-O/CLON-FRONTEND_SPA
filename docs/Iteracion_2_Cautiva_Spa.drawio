metry" /></mxCell><mxCell id="p61-58" value="tipo = SILLON, ESTACION, CAMILLA, CABINA, MESA_MANICURA, LAVACABEZAS o HIDROTERAPIA (CK_RECURSO_TIPO); minutos_limpieza (de 0 a 10 desde v5.1) bloquea el recurso después de cada servicio (RN03)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p61-59" value="RECURSO es del módulo sedes; ServicioRecurso implementa RecursoApi para agenda y catálogo." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p61-60" value="[It. 2] CUS modificado: listarRecursos muestra los recursos de la sede con su tipo, estado y limpieza (diferencia 18 del front-end); CUS08 los usa por RecursoApi." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p61-61" value="Diagrama de clases del análisis — Registrar Recurso" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1196" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p61-62" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1256" width="30" height="60" as="geometry" /></mxCell><mxCell id="p61-63" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;