ay></mxGeometry></mxCell><mxCell id="p32-61" value="HTTP/POST /api/v1/productos: registrar(oProductoDTO) [RF44, RF45]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525" y="1036" as="sourcePoint" /><mxPoint x="720" y="1036" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p32-62" value="registrar(oProductoDTO)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="1066" as="sourcePoint" /><mxPoint x="925" y="1066" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p32-63" value="obtenerValorNumero(codigo) [RF87]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1096" as="sourcePoint" /><mxPoint x="1335" y="1096" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p32-64" value="margen" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="1126" as="sourcePoint" /><mxPoint x="935" y="1126" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p32-65" value="oProducto = new Producto(codigo, nombre, marca, idCategoria, unidad, tipoUso, costo) [RF44, RF45, RN13]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1156" as="sourcePoint" /><mxPoint x="1540" y="1156" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p32-66" value="calcularPrecioVenta(margen) [RF87]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1186" as="sourcePoint" /><mxPoint x="1540" y="1186" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p32-67" value="definirStockMinimo(idSede, stockMinimo, ubicacion) [RF86, RN16]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1216" as="sourcePoint" /><mxPoint x="1540" y="1216" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p32-68" value="save(oProducto)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1246" as="sourcePoint" /><mxPoint x="1745" y="1246" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p32-69" value="INSERT INTO PRODUCTO, INVENTARIO_SEDE" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1755" y="1276" as="sourcePoint" /><mxPoint x="1950" y="1276" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p32-70" value="idProducto" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="1306" as="sourcePoint" /><mxPoint x="1755" y="1306" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p32-71" value="oProducto" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="1336" as="sourcePoint" /><mxPoint x="935" y="1336" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p32-72" value="oProductoDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1366" as="sourcePoint" /><mxPoint x="730" y="1366" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p32-73" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1396" as="sourcePoint" /><mxPoint x="525" y="1396" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p32-74" value="mostrarProducto(oProductoDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="1426" as="sourcePoint" /><mxPoint x="320" y="1426" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p32-75" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1486" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p32-76" value="tipo_uso clasifica el producto como VENTA o INSUMO de uso interno (RF44, RN13)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p32-77" value="precio_venta = costo × (1 + margen); el margen vive en PARAMETRO (seguridad), no en el código, y la encargada puede ajustarlo antes de guardar (RF87)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p32-78" value="El stock mínimo se configura por producto y por sede en INVENTARIO_SEDE (RF86, RN16)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p32-79" value="[It. 2] listarProductos lista productos e insumos con su stock de la sede; lo usan CUS33 a CUS35 y el registro de insumos de CUS57 (diferencia 34 del front-end). El producto nace con stock 0 en la sede: el stock solo cambia por kardex (TRG_KARDEX_APLICAR)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2095" y="600" width="330" height="90" as="geometry" /></mxCell><mxCell id="p32-80" value="Diagrama de clases del análisis — Registrar Producto" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1556" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p32-81" value="Encargada de Almacén" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="1616" width="30" height="60" as="geometry" /></mxCell><mxCell id="p32-82" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackground