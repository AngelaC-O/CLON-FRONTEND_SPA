e=11;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i_dom-143" target="i_dom-63"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="i_dom-571" value="{complete, overlapping} · PK compartida" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=0;endSize=16;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i_dom-391" target="i_dom-63"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="i_dom-572" value="{complete, disjoint} · PK compartida" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=0;endSize=16;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i_dom-296" target="i_dom-276"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="BD · Modelo conceptual · It. 2" id="j_conc"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="i_conc-1" value="Modelo conceptual de BD — Iteraciones 1 + 2 (entidades extraídas de los diagramas de clases del análisis y del diseño)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="40" as="geometry" /></mxCell><mxCell id="i_conc-2" value="Entidades = las 41 tablas que escriben o leen los 47 CUS de las Iteraciones 1 y 2 (las tablas asociativas no son entidades: aquí aparecen como relaciones N:M en rojo). Las entidades punteadas son de contexto: las referencian las de la iteración, pero sus CUS llegan después. Atributos sin FK ni tipos (eso es del modelo lógico). Relaciones y verbos: hoja «Relaciones conceptuales» del diccionario v5." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent=