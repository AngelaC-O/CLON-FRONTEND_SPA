xCell id="p34-49" value="estaEnMinimo(idSede) [RF47]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="856" as="sourcePoint" /><mxPoint x="1130" y="856" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p34-50" value="true" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="886" as="sourcePoint" /><mxPoint x="935" y="886" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p34-51" value="oMovimientoDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="916" as="sourcePoint" /><mxPoint x="730" y="916" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p34-52" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="946" as="sourcePoint" /><mxPoint x="525" y="946" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p34-53" value="mostrarAlertaStockMinimo(oMovimientoDTO) [RF47]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="976" as="sourcePoint" /><mxPoint x="320" y="976" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p34-54" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1036" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p34-55" value="cantidad = unidades contadas en el conteo físico; el sistema registra la diferencia como movimiento de AJUSTE con motivo, fecha y usuario (RF48)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p34-56" value="Si el ajuste deja el producto en su stock mínimo, se alerta igual que en CUS33 (RF47)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p34-57" value="[It. 2] El AJUSTE guarda la diferencia con signo (contado − stock_actual; CK_MOV_KARDEX_CANTIDAD exige que no sea 0): Java la calcula y, si es 0, no registra nada. El stock lo actualiza TRG_KARDEX_APLICAR." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1685" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p34-58" value="Diagrama de clases del análisis — Registrar Ajuste de Inventario" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1106" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p34-59" value="Encargada de Almacén" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;l