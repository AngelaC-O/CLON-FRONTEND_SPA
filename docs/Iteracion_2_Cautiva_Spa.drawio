ll=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="1876" as="sourcePoint" /><mxPoint x="515" y="1876" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-108" value="HTTP/POST /api/v1/solicitudes-anulacion/{idSolicitud}/rechazo: rechazar(idSolicitud, motivoRechazo) [RF33]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525" y="1906" as="sourcePoint" /><mxPoint x="720" y="1906" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-109" value="rechazar(idSolicitud, motivoRechazo)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="1936" as="sourcePoint" /><mxPoint x="925" y="1936" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-110" value="findById(idSolicitud)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1966" as="sourcePoint" /><mxPoint x="1130" y="1966" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-111" value="oSolicitud" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="1996" as="sourcePoint" /><mxPoint x="935" y="1996" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-112" value="rechazar(idUsuarioResuelve, motivoRechazo) [RN32]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="2026" as="sourcePoint" /><mxPoint x="1335" y="2026" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-113" value="save(oSolicitud)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="2056" as="sourcePoint" /><mxPoint x="1130" y="2056" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-114" value="UPDATE SOLICITUD_ANULACION" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="2086" as="sourcePoint" /><mxPoint x="3180" y="2086" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-115" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3180" y="2116" as="sourcePoint" /><mxPoint x="1140" y="2116" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-116" value="oSolicitudAnulacionDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="2146" as="sourcePoint" /><mxPoint x="730" y="2146" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-117" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="2176" as="sourcePoint" /><mxPoint x="525" y="2176" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-118" value="mostrarBandeja(lista) [RF33]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="2206" as="sourcePoint" /><mxPoint x="320" y="2206" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p23-119" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="2266" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p23-120" value="[It. 2 · v5.1] Bandeja de la Administradora: aprueba o rechaza las solicitudes PENDIENTES de CUS22 (RN32, RES16). Al aprobar, en una transacción: emite la nota de crédito (subtipo de COMPROBANTE, serie BC01 o FC01, número de Oracle), pasa la venta a ANULADA (TRG_VENTA_EFECTOS → PKG_VENTA.al_anular devuelve la atención, anula el paquete, abona el saldo y reingresa productos) y marca la solicitud APROBADA con su id_nota_credito. Si SUNAT había RECHAZADO el comprobante, se anula sin nota de crédito." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3325" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p23-121" value="Al rechazar, la solicitud guarda el motivo del rechazo y la venta sigue CERRADA." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3325" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p23-122" value="La nota se envía a SUNAT por APISPERU como el comprobante de CUS19 (RN47); si no responde queda PENDIENTE y la reenvía ReenvioCpeJob (RN46). id_usuario_solicita de la nota sale de la solicitud y id_usuario_autoriza es la Administradora." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="3325" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p23-123" value="Diagrama de clases del análisis — Emitir Nota de Crédito" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="2336" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p23-124" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="2396" width="30" height="60" as="geometry" /></mxCell><mxCell id="p23-125" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2396" width="110" height="80" as="geometry" /></mxCell><mxCell id="p23-126" value="IGU_Anulacion" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2546" width="110" height="80" as="geometry" /></mxCell><mxCell id="p23-127" value="ControladorAnulacion" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="677.0" y="2396" width="80" height="80" as="geometry" /></mxCell><mxCell id="p23-128" value="ServicioAnulacion" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;