mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1982" as="sourcePoint" /><mxPoint x="1540" y="1982" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p53-96" value="verificarPermisosMinimos() [RN48]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="2012" as="sourcePoint" /><mxPoint x="1540" y="2012" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p53-97" value="save(oRol)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="2042" as="sourcePoint" /><mxPoint x="1745" y="2042" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p53-98" value="UPDATE ROL; INSERT INTO ROL_PERMISO" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1755" y="2072" as="sourcePoint" /><mxPoint x="2155" y="2072" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p53-99" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2155" y="2102" as="sourcePoint" /><mxPoint x="1755" y="2102" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p53-100" value="oRolDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="2132" as="sourcePoint" /><mxPoint x="730" y="2132" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p53-101" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="2162" as="sourcePoint" /><mxPoint x="525" y="2162" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p53-102" value="mostrarPermisos(oRolDTO) [RF78]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="2192" as="sourcePoint" /><mxPoint x="320" y="2192" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p53-103" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="2252" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p53-104" value="Un solo rol por usuario (RN39). Los permisos del rol definen los módulos que verá al ingresar (RF78); solo la administradora ve costos, márgenes y planilla (RN24)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p53-105" value="v5: el diccionario asigna a CUS53 también ROL, PERMISO y ROL_PERMISO: la administradora ajusta los permisos (módulo + acción) de cada rol. Los cuatro roles y sus permisos iniciales los carga el script." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p53-106" value="[It. 2 · RN48] CUS modificado (D-07): el rol ADMINISTRADORA conserva siempre SEGURIDAD:VER, SEGURIDAD:CREAR y SEGURIDAD:EDITAR (Rol.verificarPermisosMinimos, 422) y no se cambia el rol de la última administradora activa. listarUsuarios y listarPermisos llenan las listas que hoy se escriben a mano (diferencias 14 y 16 del front-end)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p53-107" value="Diagrama de clases del análisis — Asignar Rol" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="2322" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p53-108" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="2382" width="30" height="60" as="geometry" /></mxCell><mxCell id="p53-109" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2382" width="110" height="80" as="geometry" /></mxCell><mxCell id="p53-110" value="IGU_Usuarios" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="2532" width="110" height="80" as="geometry" /></mxCell><mxCell id="p53-111" value="ControladorUsuario" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fo