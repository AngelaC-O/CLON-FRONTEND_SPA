e="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="1846" as="sourcePoint" /><mxPoint x="925" y="1846" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p47-92" value="findById(idConciliacion)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1876" as="sourcePoint" /><mxPoint x="1745" y="1876" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p47-93" value="oConciliacion" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="1906" as="sourcePoint" /><mxPoint x="935" y="1906" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p47-94" value="cerrar(fechaCierre) [RF75, RN31]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1936" as="sourcePoint" /><mxPoint x="1540" y="1936" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p47-95" value="save(oConciliacion)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="1966" as="sourcePoint" /><mxPoint x="1745" y="1966" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p47-96" value="UPDATE CONCILIACION" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1755" y="1996" as="sourcePoint" /><mxPoint x="2155" y="1996" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p47-97" value="ok" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2155" y="2026" as="sourcePoint" /><mxPoint x="1755" y="2026" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p47-98" value="oConciliacionDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="2056" as="sourcePoint" /><mxPoint x="730" y="2056" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p47-99" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="2086" as="sourcePoint" /><mxPoint x="525" y="2086" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p47-100" value="mostrarConciliacion(oConciliacionDTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="2116" as="sourcePoint" /><mxPoint x="320" y="2116" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p47-101" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="2176" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p47-102" value="Compara las ventas del sistema con los comprobantes ACEPTADOS por SUNAT (con sus notas de crédito) y con las transacciones, comisiones y abonos de la pasarela (RN31). Una diferencia puede nacer solo en la pasarela (CK_CONC_ITEM_ORIGEN)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p47-103" value="v5.1: la comisión y la fecha de abono salen del reporte de liquidación que la Administradora descarga del panel de Izipay (Excel o CSV) y sube; LectorReporteLiquidacion lo lee y PagosApi.registrarLiquidacion completa TRANSACCION_PASARELA por codigo_operacion (RF105). No hay API pública de liquidación ni job diario. Luego se leen V_PASARELA_LIQUIDACION y V_COMPROBANTES_MES." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p47-104" value="Una sola conciliación por mes para toda la empresa (un único RUC)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p47-105" value="[It. 2 · v5.1] Cada diferencia SIN_JUSTIFICAR se marca JUSTIFICADA (con justificación) o EXCLUIDA; la conciliación se CIERRA cuando no queda ninguna SIN_JUSTIFICAR y ya no cambia (CK_CONCILIACION_CIERRE). Las devoluciones de Yape y Plin hechas a mano (CUS24) se justifican aquí." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="600" width="330" height="90" as="geometry" /></mxCell><mxCell id="p47-106" value="Diagrama de clases del análisis — Conciliar Ventas del Mes" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=