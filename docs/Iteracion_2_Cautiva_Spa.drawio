pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="i_dom-1" value="Diagrama general de clases del diseño (dominio) — Iteración 2: entidades JPA de los 27 CUS nuevos y los 12 modificados" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="40" as="geometry" /></mxCell><mxCell id="i_dom-2" value="Solo las 44 tablas que escriben o leen los CUS de la iteración (atributos = columnas del diccionario v5). Composición (rombo lleno) = agregado; línea simple = FK dentro del módulo; entre módulos la relación es un atributo idX." style="text;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1800" height="24" as="geometry" /></mxCell><mxCell id="i_dom-3" value="Módulo seguridad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="841.6" height="974" as="geometry" /></mxCell><mxCell id="i_dom-4" value="&amp;laquo;entity&amp;raquo;&lt;br&gt;Usuario" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60.0" y="160" width="208.0" height="268" as="geometry" /></mxCell><mxCell id="i_dom-5" value="-idUsuario: Long" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="i_dom-4"><mxGeometry x="0" y="40" width="208.0" height="20" as="geometry" /></mxCell><mxCell id="i_dom-6" value="-idPersonal: Long