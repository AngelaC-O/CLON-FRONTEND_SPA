as="geometry"><mxPoint x="2360" y="1712" as="sourcePoint" /><mxPoint x="2165" y="1712" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p50-96" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2155" y="1742" as="sourcePoint" /><mxPoint x="525" y="1742" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p50-97" value="mostrarAvisos(lista) [RF47, RF101]" style="html=1;align=left;spacingLeft=4;verticalAlign=middle;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525" y="1772" as="sourcePoint" /><mxPoint x="525" y="1788" as="targetPoint" /><Array as="points"><mxPoint x="560" y="1772" /><mxPoint x="560" y="1788" /></Array></mxGeometry></mxCell><mxCell id="p50-98" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1848" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p50-99" value="Clave incorrecta: mensaje claro y Usuario.registrarIntentoFallido(); al 5.º intento seguido la cuenta queda BLOQUEADA (RF77)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2915" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p50-100" value="Los módulos se habilitan según el rol; costos, márgenes y planilla solo para la administradora (RF78, RN24). Si debe_cambiar_clave = 'S', la IGU pide la clave nueva (CUS54)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2915" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p50-101" value="[It. 2] CUS modificado: al recargar, obtenerSesion devuelve la sesión vigente (401 si no hay) con idPersonal, nombres, rol y permisos, para no guardarla en el navegador (Dudas 3 y 6, diferencia 2 del front-end)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2915" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p50-102" value="[It. 2 · v5.1] Panel de avisos de Inicio (RF47, RF101): ControladorAviso y ServicioAviso (seguridad) juntan lo que publica cada módulo por el SPI comun.api.AvisoProvider: inventario (productos en stock mínimo y consumos pendientes), ventas (comprobantes PENDIENTES cerca del plazo de 3 días y solicitudes de anulación pendientes) y caja (cierres con diferencia por aprobar). Se filtran por los permisos del rol. Sin tabla nueva." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2915" y="600" width="330" height="90" as="geometry" /></mxCell><mxCell id="p50-103" value="Diagrama de clases del análisis — Iniciar Sesión" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="1918" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p50-104" value="Personal del Spa" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0