<mxfile host="app.diagrams.net" agent="Cautiva Spa U2 · Iteración 2.1" version="24.7.0"><diagram name="00 Iteración 2.1 · Objetivo y decisiones" id="k00"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="k00-1" value="Iteración 2.1 — Ajustes antes de la Iteración 3: sin tiempo de limpieza, migración 18 (v5.2) y nombres en todas las pantallas" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="40" as="geometry" /></mxCell><mxCell id="k00-2" value="&lt;b&gt;Objetivo:&lt;/b&gt; cerrar la Iteración 2 sin pendientes antes de planificar la Iteración 3. No agrega CUS (siguen 47 de 67): corrige lo que quedó abierto. Al terminar, (1) la agenda libera a la especialista y al recurso en cuanto termina el servicio, igual en Java y en Oracle; (2) la base pasa al diccionario v5.2 con el script 18 (D-15, D-16, D-17, D-21, D-22, D-37); (3) ninguna pantalla muestra un id en lugar de un nombre; (4) los datos de prueba tienen el horario real (todos los días, 09:00 a 20:00, con un día de descanso por persona) y la prueba e2e corre completa cualquier día de 09:00 a 18:00; (5) se etiqueta &lt;b&gt;v0.2.1-it2&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Iterativo:&lt;/b&gt; se recorre otra vez negocio → requerimientos → análisis → diseño → implementación → pruebas, solo para los cambios. &lt;b&gt;Incremental:&lt;/b&gt; no hay funcionalidad nueva; se corrige y completa la ya entregada." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;rounded=1;fillColor=#FFF0F9;strokeColor=#B70050;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1650" height="190" as="geometry" /></mxCell><mxCell id="k00-3" value="&lt;b&gt;Decisiones del 15/11/2026&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:12px'&gt;&lt;tr style='background:#FFF0F9'&gt;&lt;th&gt;N°&lt;/th&gt;&lt;th&gt;Decisión&lt;/th&gt;&lt;th&gt;Cierra o viene de&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;Script 17 en la base local &lt;i&gt;oracle-local&lt;/i&gt;: confirmado (57 tablas, 131 FK, 129 triggers, 0 inválidos).&lt;/td&gt;&lt;td&gt;D-18 cerrada&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;E2E, camino B: primero se corrigen el horario de prueba y la ventana de la e2e; después se corre.&lt;/td&gt;&lt;td&gt;Duda del horario&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;&lt;b&gt;Se elimina el tiempo de limpieza:&lt;/b&gt; la especialista y el recurso quedan libres en cuanto termina el servicio.&lt;/td&gt;&lt;td&gt;RN03, RF06, RF14, RF85, RES06; cierra D-14, DF-58, DF-59, DF-81&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;Migración 18 (diccionario v5.2): D-15, D-16, D-17, D-21, D-22 y D-37, como se recomendó.&lt;/td&gt;&lt;td&gt;Recomendación aprobada&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;&lt;b&gt;Nombres, nunca ids, en el front-end:&lt;/b&gt; toda respuesta que una pantalla muestra trae el nombre.&lt;/td&gt;&lt;td&gt;Dudas 1, 2, 7, 9, 14, 21 y 25 del front-end; D-31, D-33&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;La sede abre todos los días de 09:00 a 20:00 (caso) y cada persona tiene su día de descanso (sin fila en HORARIO_PERSONAL ese día).&lt;/td&gt;&lt;td&gt;Horario de los datos de prueba&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;RNF04 lo actualizó el equipo en la matriz.&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="1000" height="560" as="geometry" /></mxCell><mxCell id="k00-4" value="&lt;b&gt;Dudas que no entran en la Iteración 2.1&lt;/b&gt; (quedan anotadas, con su momento)&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:11px'&gt;&lt;tr style='background:#FFF0F9'&gt;&lt;th&gt;Duda&lt;/th&gt;&lt;th&gt;Tema&lt;/th&gt;&lt;th&gt;Cuándo&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D-05, D-32, D-34, DF-49&lt;/td&gt;&lt;td&gt;Izipay real: código de operación del enlace, uuid de la IPN para el reembolso y formato del reporte de liquidación&lt;/td&gt;&lt;td&gt;Cuando la dueña pida las claves TEST&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D-09&lt;/td&gt;&lt;td&gt;Hora de almuerzo de la especialista en la agenda&lt;/td&gt;&lt;td&gt;Iteración 3 (personal y asistencia)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DF-52&lt;/td&gt;&lt;td&gt;Importe del comprobante con adelanto&lt;/td&gt;&lt;td&gt;Revisión con la contadora&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D-19, D-35&lt;/td&gt;&lt;td&gt;Criterios de la conciliación y una conciliación por mes&lt;/td&gt;&lt;td&gt;Revisión con la dueña y la contadora&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D-23, D-25, D-38&lt;/td&gt;&lt;td&gt;Firma de AvisoProvider, rutas de los avisos y nombres de los tipos de reporte (ya implementados así)&lt;/td&gt;&lt;td&gt;Se aceptan como están; se anotan como decisiones&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;D-26, D-27, D-28, D-29, D-30, D-36&lt;/td&gt;&lt;td&gt;Sede del consumo automático, espera de otra clienta, saldo en CUS10, estado para recomendar, quitar insumos, reactivar cuenta INACTIVA&lt;/td&gt;&lt;td&gt;Planificación de la Iteración 3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Front-end 12, 13, 15, 23, 29, 31, 32&lt;/td&gt;&lt;td&gt;Anulación pendiente en VentaDTO, lista de ventas, devoluciones hechas, GET de la conciliación, GET /sedes, alta de serie y venta de paquete&lt;/td&gt;&lt;td&gt;Planificación de la Iteración 3&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1070" y="270" width="620" height="760" as="geometry" /></mxCell><mxCell id="k00-5" value="&lt;b&gt;Horario de los datos de prueba&lt;/b&gt; (script 19, solo local y e2e; nunca producción)&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:12px'&gt;&lt;tr style='background:#FFF0F9'&gt;&lt;th&gt;Usuario&lt;/th&gt;&lt;th&gt;Persona&lt;/th&gt;&lt;th&gt;Áreas&lt;/th&gt;&lt;th&gt;Descansa&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;admin&lt;/td&gt;&lt;td&gt;Administradora&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;domingo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;recepcion&lt;/td&gt;&lt;td&gt;Recepcionista&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;lunes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;(sin usuario)&lt;/td&gt;&lt;td&gt;Recepcionista 2&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;jueves&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;almacen&lt;/td&gt;&lt;td&gt;Encargada de almacén&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;domingo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;especialista1&lt;/td&gt;&lt;td&gt;Especialista&lt;/td&gt;&lt;td&gt;Peluquería y Estilismo, Manicura y Pedicura&lt;/td&gt;&lt;td&gt;lunes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;especialista3 (nueva)&lt;/td&gt;&lt;td&gt;Especialista&lt;/td&gt;&lt;td&gt;las mismas de especialista1&lt;/td&gt;&lt;td&gt;jueves&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;especialista2&lt;/td&gt;&lt;td&gt;Especialista&lt;/td&gt;&lt;td&gt;Cuidado Facial, Cabina Spa, Depilación&lt;/td&gt;&lt;td&gt;martes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;especialista4 (nueva)&lt;/td&gt;&lt;td&gt;Especialista&lt;/td&gt;&lt;td&gt;las mismas de especialista2&lt;/td&gt;&lt;td&gt;viernes&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Todos trabajan de 09:00 a 20:00 los demás días, con 60 minutos de almuerzo (la hora del almuerzo es D-09, Iteración 3). Cada día hay al menos una especialista para cada área. La e2e elige la que trabaja hoy." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1000" height="330" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="01 Requerimientos y diccionario v5.2 · It. 2.1" id="k01"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="k01-1" value="Modelo de requerimientos y de datos — qué cambió en la Iteración 2.1 (15/11/2026)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="40" as="geometry" /></mxCell><mxCell id="k01-2" value="&lt;b&gt;Requerimientos y caso ajustados&lt;/b&gt; (los números no cambian, para no mover la trazabilidad)&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:12px'&gt;&lt;tr style='background:#FFF0F9'&gt;&lt;th&gt;Dónde&lt;/th&gt;&lt;th&gt;Antes&lt;/th&gt;&lt;th&gt;Ahora&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RN03 (hoja 3)&lt;/td&gt;&lt;td&gt;Después de cada servicio, el recurso queda bloqueado por el tiempo de limpieza, de hasta 10 minutos; la especialista queda libre al terminar.&lt;/td&gt;&lt;td&gt;La especialista y el recurso quedan libres en cuanto termina el servicio: no hay un tiempo de limpieza que bloquee el recurso entre una atención y otra.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RES06 (hoja 3)&lt;/td&gt;&lt;td&gt;… el sistema solo controla el tiempo de limpieza entre servicios.&lt;/td&gt;&lt;td&gt;… la limpieza la hacen las especialistas y el sistema no la controla.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RF06 (hoja 2)&lt;/td&gt;&lt;td&gt;… según su duración de referencia y su tiempo de limpieza.&lt;/td&gt;&lt;td&gt;… según su duración de referencia.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RF14 (hoja 2)&lt;/td&gt;&lt;td&gt;Liberar a la especialista y bloquear el recurso por su tiempo de limpieza.&lt;/td&gt;&lt;td&gt;Liberar a la especialista y al recurso cuando termina el servicio, para agendar otra atención desde ese momento.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RF85 (hoja 2)&lt;/td&gt;&lt;td&gt;Recursos con su tipo, su sede y su tiempo de limpieza.&lt;/td&gt;&lt;td&gt;Recursos con su tipo y su sede.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Caso&lt;/td&gt;&lt;td&gt;BUC01, regla de cruces de la sección 5 y fase 1 con la limpieza.&lt;/td&gt;&lt;td&gt;Sin limpieza en lo que hace el sistema; «cómo se hace hoy» y el rol de las especialistas se conservan.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1650" height="420" as="geometry" /></mxCell><mxCell id="k01-3" value="&lt;b&gt;Diccionario de datos v5.2&lt;/b&gt; (hoja «Cambios v5.2»; lo implementa database/18_ajustes_v52.sql) — 57 tablas, 451 columnas, 132 FK&lt;br&gt;&lt;br&gt;&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:11px'&gt;&lt;tr style='background:#FFF0F9'&gt;&lt;th&gt;N°&lt;/th&gt;&lt;th&gt;Tipo&lt;/th&gt;&lt;th&gt;Objeto&lt;/th&gt;&lt;th&gt;Definición&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;Columna retirada&lt;/td&gt;&lt;td&gt;RECURSO.minutos_limpieza&lt;/td&gt;&lt;td&gt;Se elimina la columna NUMBER(5) DEFAULT 10 (y su CHECK). Nada la reemplaza.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;CHECK retirado&lt;/td&gt;&lt;td&gt;RECURSO.CK_RECURSO_MINUTOS_LIMPIEZA&lt;/td&gt;&lt;td&gt;Se elimina (minutos_limpieza BETWEEN 0 AND 10).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;Descripción cambiada&lt;/td&gt;&lt;td&gt;CITA.fecha_hora_fin&lt;/td&gt;&lt;td&gt;Fin del servicio = inicio + duración (antes sumaba la limpieza del recurso). Las citas existentes se recalculan en el script 18.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;Columna nueva&lt;/td&gt;&lt;td&gt;TRANSACCION_PASARELA.id_venta&lt;/td&gt;&lt;td&gt;NUMBER NULL, FK_TRANS_PAS_VENTA → VENTA, índice IX_TRANS_PAS_VENTA y CK_TRANS_PAS_VENTA (id_venta IS NULL OR (tipo_operacion = 'COBRO' AND id_cita IS NULL)). El script 18 la llena en los cobros ya registrados con la venta de su VENTA_PAGO; los cobros PENDIENTES sin VENTA_PAGO quedan nulos.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;Descripción cambiada&lt;/td&gt;&lt;td&gt;Tablas: RECURSO, PARAMETRO y CITA&lt;/td&gt;&lt;td&gt;Sin mención de la limpieza.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;Trazabilidad corregida&lt;/td&gt;&lt;td&gt;CUS05, CUS08, CUS11, CUS13, CUS18, CUS23, CUS26, CUS46, CUS48, CUS61, CUS65&lt;/td&gt;&lt;td&gt;Ver la hoja Trazabilidad CUS (filas en naranja).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;Dato retirado&lt;/td&gt;&lt;td&gt;PARAMETRO LIMPIEZA_MAX_MIN&lt;/td&gt;&lt;td&gt;Se borra la fila (era 10).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;Paquete cambiado&lt;/td&gt;&lt;td&gt;PKG_AGENDA&lt;/td&gt;&lt;td&gt;fin_con_limpieza(p_inicio, p_minutos, p_id_recurso) se reemplaza por fin_atencion(p_inicio, p_minutos) = inicio + minutos. validar_cruce compara la especialista y el recurso con el mismo fin (sin limpieza) en CITA y en ATENCION; el mensaje -20010 ya no menciona la limpieza. validar_atencion usa fin_atencion.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;Trigger cambiado&lt;/td&gt;&lt;td&gt;TRG_CITA_REGLAS&lt;/td&gt;&lt;td&gt;fecha_hora_fin := fecha_hora_inicio + duracion_min (sin minutos_limpieza). El resto no cambia.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;Vista cambiada&lt;/td&gt;&lt;td&gt;V_AGENDA_BLOQUES&lt;/td&gt;&lt;td&gt;La columna fin_con_limpieza pasa a llamarse fin y vale el fin del servicio: CITA.fecha_hora_fin o, en la atención sin cita, NVL(hora_fin, hora_inicio + tiempo_declarado_min), sin la limpieza del recurso.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;Vista cambiada&lt;/td&gt;&lt;td&gt;V_OCUPACION_RECURSO&lt;/td&gt;&lt;td&gt;minutos_ocupados se calcula con b.fin (sin limpieza).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;Trigger regenerado&lt;/td&gt;&lt;td&gt;TRG_AUD_RECURSO&lt;/td&gt;&lt;td&gt;Sin la columna minutos_limpieza (mismo molde de 10_triggers_auditoria.sql).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;13&lt;/td&gt;&lt;td&gt;Trigger regenerado&lt;/td&gt;&lt;td&gt;TRG_AUD_CAJA&lt;/td&gt;&lt;td&gt;Agrega id_usuario_reapertura, fecha_reapertura y motivo_reapertura al alta, al cambio y a la baja (mismo molde de 10).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;Trigger cambiado&lt;/td&gt;&lt;td&gt;TRG_CAJA_REGLAS&lt;/td&gt;&lt;td&gt;La reapertura (CERRADA → ABIERTA) solo se permite si la caja se abrió hoy: TRUNC(fecha_apertura) = TRUNC(SYSDATE); si no, -20060.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;15&lt;/td&gt;&lt;td&gt;Trigger cambiado&lt;/td&gt;&lt;td&gt;TRG_NOTA_CREDITO_REGLAS&lt;/td&gt;&lt;td&gt;id_usuario_solicita := el id_usuario_solicita de la SOLICITUD_ANULACION PENDIENTE de esa venta; si no hay solicitud, el usuario de PKG_SESION. id_usuario_autoriza sigue siendo la Administradora de la sesión.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;16&lt;/td&gt;&lt;td&gt;Trigger cambiado&lt;/td&gt;&lt;td&gt;TRG_TRANS_PAS_REGLAS&lt;/td&gt;&lt;td&gt;Al insertar con id_venta: la venta es de la misma sede y está ABIERTA (-20072). Al actualizar, id_venta no cambia (-20072).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;17&lt;/td&gt;&lt;td&gt;Trigger regenerado&lt;/td&gt;&lt;td&gt;TRG_AUD_TRANSACCION_PASARELA&lt;/td&gt;&lt;td&gt;Agrega id_venta al alta, al cambio y a la baja (mismo molde de 10).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;18&lt;/td&gt;&lt;td&gt;Trigger cambiado&lt;/td&gt;&lt;td&gt;TRG_VENTA_PAGO_REGLAS&lt;/td&gt;&lt;td&gt;Un pago con id_transaccion cuya transacción tiene id_venta debe ser de esa misma venta (-20107, código nuevo).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;19&lt;/td&gt;&lt;td&gt;Vista cambiada&lt;/td&gt;&lt;td&gt;V_VENTA_LINEA&lt;/td&gt;&lt;td&gt;Suma las columnas id_producto (VENTA_DETALLE), id_variante (de la atención) e id_paquete (VENTA_DETALLE).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;Vista cambiada&lt;/td&gt;&lt;td&gt;V_KARDEX&lt;/td&gt;&lt;td&gt;Suma las columnas comprobante (serie-número de la boleta o factura de la venta, por VENTA_DETALLE y COMPROBANTE) y documento_compra (COMPRA.documento, por COMPRA_DETALLE). Nulas cuando el movimiento no viene de una venta o una compra.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;21&lt;/td&gt;&lt;td&gt;Script cambiado&lt;/td&gt;&lt;td&gt;99_eliminar_v5.sql&lt;/td&gt;&lt;td&gt;También borra SOLICITUD_ANULACION y CONSUMO_PENDIENTE (antes que sus tablas padre).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;22&lt;/td&gt;&lt;td&gt;Comentario cambiado&lt;/td&gt;&lt;td&gt;PARAMETRO (tabla), RECURSO (tabla), CITA.fecha_hora_fin, IX_CITA_AGENDA_RECURSO&lt;/td&gt;&lt;td&gt;Sin mención de la limpieza.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1650" height="1100" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="02 Nombres en las respuestas · It. 2.1" id="k02"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="k02-1" value="Nombres en las respuestas — ninguna pantalla muestra un id en lugar de un nombre (decisión del 15/11/2026)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="40" as="geometry" /></mxCell><mxCell id="k02-2" value="&lt;b&gt;Regla:&lt;/b&gt; toda respuesta que una pantalla muestra trae el nombre de las personas (clienta, especialista, usuario), del servicio y su variante, del recurso, del producto, del paquete, del medio de pago y de la sede. Los números de documentos transaccionales (cita, atención, venta, caja) se pueden mostrar como «N° 123», y la venta, mejor con su comprobante (B001-123). Los id siguen en los DTO (el front-end los usa para las llamadas), pero nunca se muestran solos ni con un texto de respaldo como «Clienta 407».&lt;br&gt;&lt;br&gt;&lt;b&gt;Cómo se dibuja:&lt;/b&gt; los mensajes que buscan los nombres (PersonaApi, CatalogoApi, RecursoApi, InventarioApi, UsuarioApi, SedeApi) no se repiten en cada diagrama de secuencia: esta página manda y cada página CUS afectada lo dice en su nota [It. 2.1 · nombres]. Se buscan en lote (una llamada por lista de ids), nunca uno por fila. Las interfaces nuevas respetan la modularidad (ModularidadTest); si una crea un ciclo, va como SPI en comun.api, como AvisoProvider." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;rounded=1;fillColor=#FFF0F9;strokeColor=#B70050;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1650" height="150" as="geometry" /></mxCell><mxCell id="k02-3" value="&lt;table border='1' cellpadding='4' style='border-collapse:collapse;font-size:11px'&gt;&lt;tr style='background:#FFF0F9'&gt;&lt;th&gt;Módulo&lt;/th&gt;&lt;th&gt;DTO&lt;/th&gt;&lt;th&gt;Endpoints&lt;/th&gt;&lt;th&gt;Campos que se agregan&lt;/th&gt;&lt;th&gt;De dónde sale el nombre&lt;/th&gt;&lt;th&gt;CUS&lt;/th&gt;&lt;th&gt;Pantalla&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;&lt;b&gt;CitaAtencionDTO&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET /atenciones/mi-agenda&lt;/td&gt;&lt;td&gt;nombreCliente, nombreServicio, nombreRecurso&lt;/td&gt;&lt;td&gt;PersonaApi.obtenerPersonas, CatalogoApi.obtenerVariantes, RecursoApi.listarRecursos&lt;/td&gt;&lt;td&gt;CUS11&lt;/td&gt;&lt;td&gt;Mi agenda (Duda 1)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;&lt;b&gt;AtencionDTO&lt;/b&gt;&lt;/td&gt;&lt;td&gt;POST /atenciones, GET /atenciones/en-curso, PATCH /atenciones/{id}/fin&lt;/td&gt;&lt;td&gt;nombreCliente, nombreEspecialista, nombreServicio, nombreRecurso&lt;/td&gt;&lt;td&gt;las mismas&lt;/td&gt;&lt;td&gt;CUS11&lt;/td&gt;&lt;td&gt;Atención en curso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;&lt;b&gt;CitaDTO (solo en respuestas)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET, POST y PATCH de /citas; citasPendientes de la ficha&lt;/td&gt;&lt;td&gt;nombreCliente, nombreEspecialista, nombreServicio, nombreRecurso&lt;/td&gt;&lt;td&gt;las mismas&lt;/td&gt;&lt;td&gt;CUS03, CUS05, CUS09, CUS10&lt;/td&gt;&lt;td&gt;Ficha, reprogramar y cancelar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;&lt;b&gt;FichaClienteDTO.AtencionFicha&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET /clientes/{id}&lt;/td&gt;&lt;td&gt;nombreServicio, nombreEspecialista, nombreRecurso&lt;/td&gt;&lt;td&gt;las mismas&lt;/td&gt;&lt;td&gt;CUS03&lt;/td&gt;&lt;td&gt;Ficha: historial (Duda 9)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;&lt;b&gt;FichaClienteDTO.PaqueteFicha&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET /clientes/{id}&lt;/td&gt;&lt;td&gt;nombrePaquete&lt;/td&gt;&lt;td&gt;CatalogoApi.obtenerPaquetes (nuevo)&lt;/td&gt;&lt;td&gt;CUS03&lt;/td&gt;&lt;td&gt;Ficha: paquetes (Duda 9)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;&lt;b&gt;RecomendacionDTO&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET /clientes/{id}, POST /atenciones/{id}/recomendaciones&lt;/td&gt;&lt;td&gt;nombreProducto&lt;/td&gt;&lt;td&gt;InventarioApi.obtenerProductos (nuevo)&lt;/td&gt;&lt;td&gt;CUS03, CUS12&lt;/td&gt;&lt;td&gt;Ficha y atención&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;&lt;b&gt;FranjaAgendaDTO&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET /citas/agenda&lt;/td&gt;&lt;td&gt;nombreRecurso (finServicio se retira)&lt;/td&gt;&lt;td&gt;RecursoApi.listarRecursos&lt;/td&gt;&lt;td&gt;CUS08&lt;/td&gt;&lt;td&gt;Agenda&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;&lt;b&gt;HoraLibre&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET /citas/disponibilidad, GET /ventas/rapidas/libres&lt;/td&gt;&lt;td&gt;especialistas [{idPersonal, nombre}], recursos [{idRecurso, nombre}] (se conservan idsPersonal e idsRecurso)&lt;/td&gt;&lt;td&gt;PersonaApi.obtenerPersonas, RecursoApi.listarRecursos&lt;/td&gt;&lt;td&gt;CUS05, CUS09, CUS13&lt;/td&gt;&lt;td&gt;Nueva cita, reprogramar, venta rápida (diferencia 11)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;agenda&lt;/td&gt;&lt;td&gt;&lt;b&gt;AtencionCobrable&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET /ventas/por-cobrar&lt;/td&gt;&lt;td&gt;nombreCliente (o el nombre del cliente de paso), nombreServicio, nombreEspecialista&lt;/td&gt;&lt;td&gt;PersonaApi, CatalogoApi&lt;/td&gt;&lt;td&gt;CUS18&lt;/td&gt;&lt;td&gt;Cobros: por cobrar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ventas&lt;/td&gt;&lt;td&gt;&lt;b&gt;VentaDTO&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET /ventas/{id}, POST de ventas, por-cobrar&lt;/td&gt;&lt;td&gt;nombreCliente&lt;/td&gt;&lt;td&gt;PersonaApi&lt;/td&gt;&lt;td&gt;CUS18, CUS22, CUS26&lt;/td&gt;&lt;td&gt;Cobros, solicitud de anulación&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ventas&lt;/td&gt;&lt;td&gt;&lt;b&gt;DetalleVentaDTO&lt;/b&gt;&lt;/td&gt;&lt;td&gt;las mismas&lt;/td&gt;&lt;td&gt;descripcion (servicio y variante, producto o paquete), nombreEspecialista&lt;/td&gt;&lt;td&gt;AtencionApi, CatalogoApi, InventarioApi.obtenerProductos, PersonaApi&lt;/td&gt;&lt;td&gt;CUS18, CUS26&lt;/td&gt;&lt;td&gt;Detalle de la venta («Atención 12» hoy)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ventas&lt;/td&gt;&lt;td&gt;&lt;b&gt;PagoVentaDTO&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET /ventas/{id}&lt;/td&gt;&lt;td&gt;nombreMedioPago&lt;/td&gt;&lt;td&gt;PagosApi (medios de pago)&lt;/td&gt;&lt;td&gt;CUS18, CUS24&lt;/td&gt;&lt;td&gt;Cobros y devoluciones&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ventas&lt;/td&gt;&lt;td&gt;&lt;b&gt;ProformaDTO.Item&lt;/b&gt;&lt;/td&gt;&lt;td&gt;POST /proformas&lt;/td&gt;&lt;td&gt;descripcion&lt;/td&gt;&lt;td&gt;CatalogoApi&lt;/td&gt;&lt;td&gt;CUS21&lt;/td&gt;&lt;td&gt;Proforma («Variante 2» hoy)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ventas&lt;/td&gt;&lt;td&gt;&lt;b&gt;SolicitudAnulacionDTO&lt;/b&gt;&lt;/td&gt;&lt;td&gt;/solicitudes-anulacion y /ventas/{id}/solicitudes-anulacion&lt;/td&gt;&lt;td&gt;nombreCliente, nombreUsuarioSolicita, nombreUsuarioResuelve&lt;/td&gt;&lt;td&gt;PersonaApi, UsuarioApi.nombresUsuarios (nuevo, seguridad.api)&lt;/td&gt;&lt;td&gt;CUS22, CUS23, CUS24&lt;/td&gt;&lt;td&gt;Bandeja (Duda 14, D-31)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ventas&lt;/td&gt;&lt;td&gt;&lt;b&gt;Línea del comprobante (CPE y PDF)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;cierre de la venta y nota de crédito&lt;/td&gt;&lt;td&gt;nombre del producto en lugar de «PRODUCTO»&lt;/td&gt;&lt;td&gt;InventarioApi.obtenerProductos&lt;/td&gt;&lt;td&gt;CUS19, CUS23, CUS26&lt;/td&gt;&lt;td&gt;Boleta, factura y nota de crédito (D-33)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;caja&lt;/td&gt;&lt;td&gt;&lt;b&gt;CajaDTO&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET /cajas/abierta, /del-dia, /con-diferencia, cierre, revisión, reapertura&lt;/td&gt;&lt;td&gt;nombreUsuarioApertura, nombreUsuarioCierre, nombreUsuarioRevisa, nombreUsuarioReapertura&lt;/td&gt;&lt;td&gt;UsuarioApi.nombresUsuarios&lt;/td&gt;&lt;td&gt;CUS44, CUS45, CUS46&lt;/td&gt;&lt;td&gt;Revisión de caja (Duda 25)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;seguridad&lt;/td&gt;&lt;td&gt;&lt;b&gt;SesionDTO&lt;/b&gt;&lt;/td&gt;&lt;td&gt;POST /auth/login, GET /auth/sesion&lt;/td&gt;&lt;td&gt;nombreSede&lt;/td&gt;&lt;td&gt;SedeApi.obtenerSede (nuevo, sedes.api)&lt;/td&gt;&lt;td&gt;CUS50&lt;/td&gt;&lt;td&gt;Cabecera, caja y reportes (Duda 7)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;seguridad&lt;/td&gt;&lt;td&gt;&lt;b&gt;UsuarioDTO (solo en respuestas)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET /usuarios y respuestas de usuarios&lt;/td&gt;&lt;td&gt;nombres, apellidos, nombreRol, ultimoAcceso&lt;/td&gt;&lt;td&gt;PersonaApi, RepositorioRol&lt;/td&gt;&lt;td&gt;CUS52, CUS53, CUS54&lt;/td&gt;&lt;td&gt;Usuarios (Duda 2)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;inventario&lt;/td&gt;&lt;td&gt;&lt;b&gt;MovimientoKardexDTO&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET /productos/{id}/kardex&lt;/td&gt;&lt;td&gt;comprobante, documentoCompra (y el front-end arma el origen con ellos)&lt;/td&gt;&lt;td&gt;V_KARDEX v5.2&lt;/td&gt;&lt;td&gt;CUS35&lt;/td&gt;&lt;td&gt;Kardex (Duda 21)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;catalogo&lt;/td&gt;&lt;td&gt;&lt;b&gt;PaqueteDTO y PromocionDTO (solo en respuestas)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;GET y POST de /paquetes y /promociones&lt;/td&gt;&lt;td&gt;servicios [{idServicio, nombre}] (se conserva idsServicio en la petición)&lt;/td&gt;&lt;td&gt;RepositorioServicio&lt;/td&gt;&lt;td&gt;CUS59, CUS60&lt;/td&gt;&lt;td&gt;Catálogo&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="1650" height="1000" as="geometry" /></mxCell><mxCell id="k02-4" value="&lt;b&gt;Interfaces nuevas:&lt;/b&gt; InventarioApi.obtenerProductos(ids) (inventario.api), CatalogoApi.obtenerPaquetes(ids) (catalogo.api), UsuarioApi.nombresUsuarios(ids) (seguridad.api: nombre completo de la persona del usuario), SedeApi.obtenerSede(idSede) (sedes.api). El origen del kardex sale de la vista V_KARDEX v5.2 porque inventario no puede depender de ventas (ventas ya depende de inventario)." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="1650" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="CUS03 Consultar Ficha de Clienta · modificado It. 2.1" id="p03"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p03-1" value="CUS03 · Consultar Ficha de Clienta — &lt;font color='#B70050'&gt;modificado en la Iteración 2.1&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry" /></mxCell><mxCell id="p03-2" value="&lt;b&gt;Módulo:&lt;/b&gt; agenda &amp;nbsp;·&amp;nbsp; &lt;b&gt;Actor:&lt;/b&gt; Recepcionista &amp;nbsp;·&amp;nbsp; &lt;b&gt;Requerimientos:&lt;/b&gt; RF02 &amp;nbsp;·&amp;nbsp; &lt;b&gt;Reglas:&lt;/b&gt; RN05, RN36 &amp;nbsp;·&amp;nbsp; &lt;b&gt;Diccionario v5.2 — escribe:&lt;/b&gt; ninguna &amp;nbsp;·&amp;nbsp; &lt;b&gt;consulta:&lt;/b&gt; PERSONA, CLIENTE, CITA, ATENCION, VENTA, CLIENTE_PAQUETE, V_SALDO_FAVOR_CLIENTE, V_SESIONES_PAQUETE" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="2000" height="24" as="geometry" /></mxCell><mxCell id="p03-3" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="30" height="60" as="geometry" /></mxCell><mxCell id="p03-4" value="Consultar Ficha de Clienta" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="95" width="300" height="60" as="geometry" /></mxCell><mxCell id="p03-5" value="" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;" edge="1" parent="1" source="p03-3" target="p03-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p03-6" value="Realización&lt;br&gt;Consultar Ficha de Clienta" style="ellipse;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="95" width="300" height="60" as="geometry" /></mxCell><mxCell id="p03-7" value="&amp;laquo;trace&amp;raquo;" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="p03-6" target="p03-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p03-8" value="Modelo de requerimientos → Modelo de análisis" style="text;html=1;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="360" height="20" as="geometry" /></mxCell><mxCell id="p03-9" value="Diagrama de secuencia — Consultar Ficha de Clienta" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p03-10" value="Recepcionista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="95.0" y="260" width="30" height="60" as="geometry" /></mxCell><mxCell id="p03-11" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260.0" y="260" width="110" height="80" as="geometry" /></mxCell><mxCell id="p03-12" value="IGU_Clientas" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="465.0" y="260" width="110" height="80" as="geometry" /></mxCell><mxCell id="p03-13" value="ControladorCliente" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="685.0" y="260" width="80" height="80" as="geometry" /></mxCell><mxCell id="p03-14" value="ServicioCliente" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="260" width="80" height="80" as="geometry" /></mxCell><mxCell id="p03-15" value