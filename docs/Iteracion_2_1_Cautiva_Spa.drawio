8" value="ventasAgrupadas(fechaInicio, fechaFin, agrupacion, idSede) [RF68, RN33]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="616" as="sourcePoint" /><mxPoint x="1130" y="616" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p48-39" value="SELECT * FROM V_VENTA_VALIDA, V_VENTA_LINEA, V_VENTAS_DIARIAS, V_MARGEN_PRODUCTO, V_COSTO_SERVICIO, V_DEMANDA_SERVICIOS, V_OCUPACION_RECURSO" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="646" as="sourcePoint" /><mxPoint x="1335" y="646" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p48-40" value="filas" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="676" as="sourcePoint" /><mxPoint x="1140" y="676" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p48-41" value="lista&amp;lt;FilaReporteDTO&amp;gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="706" as="sourcePoint" /><mxPoint x="935" y="706" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p48-42" value="oReporteDTO" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="736" as="sourcePoint" /><mxPoint x="730" y="736" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p48-43" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="766" as="sourcePoint" /><mxPoint x="525" y="766" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p48-44" value="mostrarReporte(oReporteDTO) [RF68, RF69, RF70, RF71, RF72, RF73]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;fontSize=10;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="796" as="sourcePoint" /><mxPoint x="320" y="796" as="targetPoint" /></mxGeometry></mxCell><mxCell id="p48-45" value="&lt;b&gt;Leyenda:&lt;/b&gt; mensaje = método de la clase destino &amp;nbsp;·&amp;nbsp; línea punteada = retorno &amp;nbsp;·&amp;nbsp; * = se repite por cada ítem &amp;nbsp;·&amp;nbsp; [RFxx] / [RNxx] = trazabilidad &amp;nbsp;·&amp;nbsp; ServicioX y RepositorioX los inyecta Spring (DI), por eso no hay mensaje new() para ellos." style="text;html=1;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="856" width="1800" height="24" as="geometry" /></mxCell><mxCell id="p48-46" value="tipoReporte = ventas (por día, mes, línea, servicio, especialista, medio de pago o tipo de atención, RF68), productos (rotación, stock y margen, RF69), margen por servicio y línea (RF70), demanda y días pico (RF71), ocupación de recursos por franja (RF72) o ingresos por especialista (RF73)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="270" width="330" height="90" as="geometry" /></mxCell><mxCell id="p48-47" value="idSede nulo = consolidado de todas las sedes (RF93). Las ventas ANULADAS no se cuentan (RN33); costos y márgenes solo para la administradora (RN24)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="380" width="330" height="90" as="geometry" /></mxCell><mxCell id="p48-48" value="El módulo reportes solo lee las vistas de reporte del diccionario v5 (V_VENTA_VALIDA, V_VENTA_LINEA, V_VENTAS_DIARIAS, V_MARGEN_PRODUCTO, V_COSTO_SERVICIO, V_DEMANDA_SERVICIOS, V_OCUPACION_RECURSO); no tiene entidades propias." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="490" width="330" height="90" as="geometry" /></mxCell><mxCell id="p48-49" value="[It. 2.1 · v5.2 · D-37] V_VENTA_LINEA trae id_producto, id_variante e id_paquete: los reportes de productos y de margen unen por id, no por nombre." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="600" width="330" height="90" as="geometry" /></mxCell><mxCell id="p48-50" value="Diagrama de clases del análisis — Generar Reporte Gerencial" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#FF0000;" vertex="1" parent="1"><mxGeometry x="40" y="926" width="1400" height="30" as="geometry" /></mxCell><mxCell id="p48-51" value="Administradora" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100.0" y="986" width="30" height="60" as="geometry" /></mxCell><mxCell id="p48-52" value="Navegador" style="shape=umlBoundary;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="368.0" y="986" width="110" height="80" as="geometry" /></mxCell><mxCell id="p48-53" value="IGU_Reportes